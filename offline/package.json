{
  "name": "mcalccanvas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Windows desktop engineering worksheets",
  "author": "mCalcCanvas",
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node prepare.mjs",
    "start": "electron .",
    "test": "node smoke.mjs",
    "build": "npm run prepare:app && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.mcalccanvas.desktop",
    "productName": "mCalcCanvas",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "mCalcCanvas-${version}-win-${arch}.${ext}"
  }
}
