      "props": {
        "w": 503,
        "h": 126,
        "baseline": 20,
        "latex": "b_{w}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ x\\le0\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 2\\sqrt{R^2-\\left(d-R\\right)^2}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(2\\sqrt{R^2-\\left(R-y_{cc}\\right)^2},2\\sqrt{R^2-\\left(d-R\\right)^2}\\right)\\right.\\end{array}",
        "displayMode": "formulaResult",
