      "props": {
        "w": 60,
        "h": 32,
        "latex": "y_{cc}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ x\\le0\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 0\\,\\mathrm{mm}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle R-\\frac{\\mathrm{sum}\\left(\\sigma_{c}\\left(\\varepsilon\\left(x,x_{c}\\right)\\right)A_{c}x_{c}\\right)}{\\mathrm{sum}\\left(\\sigma_{c}\\left(\\varepsilon\\left(x,x_{c}\\right)\\right)A_{c}\\right)}\\right.\\end{array}",
