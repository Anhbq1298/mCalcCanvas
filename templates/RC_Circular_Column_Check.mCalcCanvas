    {
      "id": "s_col_45",
      "type": "text",
      "x": 76,
      "y": 6561,
      "props": {
        "w": 630,
        "h": 19,
        "html": "σcd = τEd·(cotθ + tanθ) ≤ ν·fcd (8.44), ν = 0.5 (8.2.3(6)). bw: least width between the",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
