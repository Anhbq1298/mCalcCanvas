        "latex": "d_{\\theta}\\coloneq\\begin{array}{|ll}\\displaystyle R-\\min\\left(p_{l1},p_{l2}\\right) & \\mathrm{if}\\ n_{set}\\ge2\\\\\\displaystyle R-\\min\\left(p_{l1}\\right) & \\mathrm{otherwise}\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4k",
