      "x": 400,
      "y": 12380,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\theta_{CSA}\\coloneq\\left(29+7000\\varepsilon_{x.d}\\right)^{\\circ}",
        "displayMode": "formulaResult",
