    {
      "id": "s_col_71",
      "type": "text",
      "x": 80,
      "y": 11099,
      "props": {
        "w": 630,
        "h": 24,
        "html": "1 ≤ cotθ ≤ cot θmin (8.41): 2.5; 3.0 if σcp ≥ 3 MPa and x &lt; 0.25d (linear between); 2.5 if",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_72",
      "type": "text",
      "x": 80,
      "y": 11129,
      "props": {
        "w": 630,
        "h": 24,
        "html": "x ≥ 0.25d; 2.5 − 0.1·|NEd|/VEd ≥ 1 in tension; × kA = 0.8 for class A spirals. cotθ &lt; 1",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_73",
      "type": "text",
      "x": 80,
      "y": 11159,
      "props": {
        "w": 630,
        "h": 24,
        "html": "(8.2.3(11)) is not used: σcd is least at θ = 45° and τRd,sy falls with cotθ.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
