      "y": 7722,
      "props": {
        "w": 134,
        "h": 37,
        "baseline": 21,
        "latex": "\\Delta\\coloneq\\frac{D}{n_{c}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6a",
      "type": "text",
      "x": 76,
      "y": 7783,
      "props": {
        "w": 244,
        "h": 22,
        "html": "Strip centre coordinate, from the centroid",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6b",
      "type": "math",
      "x": 336,
      "y": 7778,
      "props": {
        "w": 147,
        "h": 27,
        "baseline": 18,
        "latex": "x_{c}\\coloneq R-\\left(j+0.5\\right)\\Delta",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6c",
      "type": "text",
      "x": 76,
      "y": 7820,
      "props": {
        "w": 204,
        "h": 22,
