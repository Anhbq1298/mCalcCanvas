    {
      "id": "s_col_64",
      "type": "text",
      "x": 76,
      "y": 10665,
      "props": {
        "w": 630,
        "h": 19,
        "html": "The concrete is cut into nc thin strips parallel to the neutral axis. Each strip carries the",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_65",
      "type": "text",
      "x": 76,
      "y": 10705,
      "props": {
        "w": 630,
        "h": 19,
        "html": "stress at its centre strain; summing strip forces (× lever arm) gives the concrete N and M.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_66",
