      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{c}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{|ll}\\displaystyle 0\\,\\mathrm{MPa} & \\mathrm{if}\\ \\varepsilon\\le0\\\\\\displaystyle f_{cd}\\left(1-\\left(1-\\frac{\\varepsilon}{\\varepsilon_{c2}}\\right)^2\\right) & \\mathrm{if}\\ \\varepsilon<\\varepsilon_{c2}\\\\\\displaystyle f_{cd} & \\mathrm{otherwise}\\end{array}",
        "displayMode": "formula",
