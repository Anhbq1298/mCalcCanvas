    {
      "id": "s_col_4n",
      "type": "text",
      "x": 76,
      "y": 7612,
      "props": {
        "w": 630,
        "h": 19,
        "html": "1 ≤ cotθ ≤ cot θmin (8.41): 2.5; 3.0 if σcp ≥ 3 MPa and x &lt; 0.25d (linear between); 2.5 if",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4o",
      "type": "text",
      "x": 76,
      "y": 7652,
      "props": {
        "w": 630,
        "h": 19,
        "html": "x ≥ 0.25d; 2.5 − 0.1·|NEd|/VEd ≥ 1 in tension; × kA = 0.8 for class A spirals. cotθ &lt; 1",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4p",
      "type": "text",
      "x": 76,
      "y": 7692,
      "props": {
        "w": 630,
        "h": 19,
        "html": "(8.2.3(11)) is not used: σcd is least at θ = 45° and τRd,sy falls with cotθ.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4q",
      "type": "text",
      "x": 76,
      "y": 7732,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Design cotθ: the largest value ≤ cot θmin that keeps σcd ≤ ν·fcd.",
        "fontFamily": "Inter",
