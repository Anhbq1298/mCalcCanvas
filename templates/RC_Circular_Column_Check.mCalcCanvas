      "type": "math",
      "x": 400,
      "y": 7256,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{b}\\left(\\varepsilon\\right)\\coloneq\\sigma_{s}\\left(\\varepsilon\\right)-\\sigma_{c}\\left(\\varepsilon\\right)",
        "displayMode": "formula",
