      "x": 400,
      "y": 12420,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\mathrm{cot}_{\\theta.CSA}\\coloneq\\frac{1}{\\tan\\left(\\theta_{CSA}\\right)}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_8a",
      "type": "text",
      "x": 80,
      "y": 12484,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Design cotθ: tension (NEd &lt; 0) → CSA within 1 … cotθ,opt; compression → cotθ,opt",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_8b",
      "type": "math",
      "x": 96,
      "y": 12510,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\mathrm{cot}_{\\theta}\\coloneq\\begin{array}{|ll}\\displaystyle \\max\\left(1,\\min\\left(\\mathrm{cot}_{\\theta.CSA},\\mathrm{cot}_{\\theta.opt}\\right)\\right) & \\mathrm{if}\\ N_{Ed}<0\\,\\mathrm{kN}\\\\\\displaystyle \\mathrm{cot}_{\\theta.opt} & \\mathrm{otherwise}\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
