      "x": 76,
      "y": 7597,
      "props": {
        "w": 630,
        "h": 28,
        "html": "Concrete strips",
        "fontFamily": "Inter",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2,
