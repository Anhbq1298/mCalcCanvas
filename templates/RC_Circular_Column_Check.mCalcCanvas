    },
    {
      "id": "s_col_67",
      "type": "math",
      "x": 400,
      "y": 10739,
      "props": {
        "w": 131,
        "h": 30,
        "baseline": 20,
        "latex": "j\\coloneq\\mathrm{seq}\\left(0,n_{c}-1\\right)",
        "displayMode": "formula",
