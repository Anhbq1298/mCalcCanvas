        "h": 24,
        "html": "Depth cA at pivot A/B boundary",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4k",
      "type": "math",
      "x": 400,
      "y": 6075,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "c_{A}\\coloneq\\frac{\\varepsilon_{cu2}d_{\\theta}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4l",
      "type": "text",
      "x": 80,
      "y": 6137,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Depth yC of pivot C (εc2 in full compression)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4m",
      "type": "math",
      "x": 400,
      "y": 6125,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "y_{C}\\coloneq\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)D",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4n",
      "type": "text",
      "x": 80,
      "y": 6185,
      "props": {
        "w": 630,
        "h": 24,
        "html": "5.2 Strain plane (+ compression)",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_4o",
      "type": "text",
      "x": 80,
      "y": 6225,
      "props": {
        "w": 630,
        "h": 24,
        "html": "c = neutral-axis depth below the compression edge;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4p",
      "type": "text",
      "x": 80,
      "y": 6255,
      "props": {
        "w": 630,
        "h": 24,
        "html": "p = fibre coordinate from the centroid along θM, so R − p = fibre depth below the edge.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4q",
      "type": "text",
      "x": 80,
      "y": 6294,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A (c &lt; cA): extreme bar at −εud",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4r",
      "type": "math",
      "x": 400,
      "y": 6285,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{A}\\left(c,p\\right)\\coloneq\\varepsilon_{ud}\\frac{c-R+p}{d_{\\theta}-c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4s",
      "type": "text",
      "x": 80,
      "y": 6343,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot B (cA ≤ c ≤ D): edge at εcu2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4t",
      "type": "math",
      "x": 400,
      "y": 6335,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{B}\\left(c,p\\right)\\coloneq\\varepsilon_{cu2}\\frac{c-R+p}{c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4u",
      "type": "text",
      "x": 80,
      "y": 6405,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot C (c &gt; D): εc2 at depth yC",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4v",
      "type": "math",
      "x": 400,
      "y": 6395,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{C}\\left(c,p\\right)\\coloneq\\varepsilon_{c2}\\frac{c-R+p}{c-y_{C}}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4w",
      "type": "text",
      "x": 80,
      "y": 6449,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Strain at fibre p for depth c (pivot chosen by c)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4x",
      "type": "math",
      "x": 96,
      "y": 6485,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon\\left(c,p\\right)\\coloneq\\begin{array}{|ll}\\displaystyle \\varepsilon_{A}\\left(c,p\\right) & \\mathrm{if}\\ c<c_{A}\\\\\\displaystyle \\varepsilon_{B}\\left(c,p\\right) & \\mathrm{if}\\ c\\le D\\\\\\displaystyle \\varepsilon_{C}\\left(c,p\\right) & \\mathrm{otherwise}\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4y",
      "type": "text",
      "x": 80,
      "y": 6525,
      "props": {
        "w": 630,
        "h": 24,
        "html": "5.3 Stress laws",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_4z",
      "type": "text",
      "x": 80,
      "y": 6559,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Concrete strain argument u limited to 0 … εc2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
