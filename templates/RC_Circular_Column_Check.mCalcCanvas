      "y": 9918,
      "props": {
        "w": 630,
        "h": 24,
        "html": "x ≥ 0.25d; 2.5 − 0.1·|NEd|/VEd ≥ 1 in tension; × kA = 0.8 for class A spirals. cotθ &lt; 1",
