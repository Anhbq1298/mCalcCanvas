      "y": 9968,
      "props": {
        "w": 630,
        "h": 24,
        "html": "7.1 Equivalent rectangle",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_6n",
      "type": "text",
      "x": 80,
      "y": 10012,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Effective depth: D/2 + half-ring centroid 2r/π, weighted by bar area",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6o",
      "type": "math",
      "x": 96,
      "y": 10038,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "d\\coloneq\\frac{D}{2}+\\frac{2}{\\pi}\\cdot\\frac{n_{l1}A_{b1}r_{1}+\\delta_{2}n_{l2}A_{b2}r_{2}}{n_{l1}A_{b1}+\\delta_{2}n_{l2}A_{b2}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6p",
      "type": "text",
      "x": 80,
      "y": 10095,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Lever arm",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6q",
