      "y": 12387,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Crack angle (CSA)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_87",
