    },
    {
      "id": "s_col_64",
      "type": "text",
      "x": 76,
      "y": 7631,
      "props": {
        "w": 630,
        "h": 23,
        "html": "The concrete is cut into nc thin strips parallel to the neutral axis. Each strip carries the",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_65",
      "type": "text",
      "x": 76,
      "y": 7660,
      "props": {
        "w": 630,
        "h": 23,
        "html": "stress at its centre strain; summing strip forces (× lever arm) gives the concrete N and M.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_66",
      "type": "text",
      "x": 76,
      "y": 7694,
      "props": {
        "w": 204,
        "h": 22,
        "html": "Strip index",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_67",
      "type": "math",
      "x": 296,
      "y": 7689,
      "props": {
        "w": 126,
        "h": 27,
        "baseline": 18,
        "latex": "j\\coloneq\\mathrm{seq}\\left(0,n_{c}-1\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
