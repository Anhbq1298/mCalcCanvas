      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{s}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{|ll}\\displaystyle -f_{yd} & \\mathrm{if}\\ E_{s}\\varepsilon<-f_{yd}\\\\\\displaystyle f_{yd} & \\mathrm{if}\\ E_{s}\\varepsilon>f_{yd}\\\\\\displaystyle E_{s}\\varepsilon & \\mathrm{otherwise}\\end{array}",
        "displayMode": "formula",
