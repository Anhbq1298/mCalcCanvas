    {
      "id": "s_col_4w",
      "type": "math",
      "x": 296,
      "y": 5915,
      "props": {
        "w": 389,
        "h": 190,
        "baseline": 18,
        "latex": "\\mathrm{cot}_{\\theta min}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ N_{Ed}<0\\,\\mathrm{kN}\\\\\\quad\\left\\Vert\\displaystyle \\max\\left(1,k_{A}\\left(2.5-0.1\\cdot\\frac{\\left|N_{Ed}\\right|}{V_{Ed}}\\right)\\right)\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ x\\ge0.25d\\\\\\quad\\left\\Vert\\displaystyle 2.5k_{A}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\sigma_{cp}\\ge3\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle 3.0k_{A}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\left(2.5+0.5\\cdot\\frac{\\sigma_{cp}}{3\\,\\mathrm{MPa}}\\right)k_{A}\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4x",
      "type": "text",
      "x": 76,
      "y": 6111,
      "props": {
        "w": 630,
        "h": 22,
        "html": "Design cotθ: cot θmin if the strut holds, else the root of τEd(cotθ + tanθ) = ν·fcd; 1: strut fails",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4y",
      "type": "math",
      "x": 96,
      "y": 6139,
      "props": {
        "w": 332,
        "h": 161,
        "baseline": 21,
        "latex": "\\mathrm{cot}_{\\theta}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\tau_{Ed}\\left(\\mathrm{cot}_{\\theta min}+\\frac{1}{\\mathrm{cot}_{\\theta min}}\\right)\\le\\nu f_{cd}\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{cot}_{\\theta min}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ 2\\tau_{Ed}\\le\\nu f_{cd}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\nu f_{cd}}{2\\tau_{Ed}}+\\sqrt{\\left(\\frac{\\nu f_{cd}}{2\\tau_{Ed}}\\right)^2-1}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
