      "props": {
        "w": 208,
        "h": 47,
        "baseline": 28,
        "latex": "p_{l2}\\coloneq r_{2}\\cos\\left(\\frac{2\\pi i_{2}}{n_{l2}}\\mathrm{rad}-\\theta_{M}\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6l",
      "type": "text",
      "x": 76,
      "y": 11306,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Depth dθ: compression edge to extreme bar",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6m",
      "type": "math",
      "x": 400,
      "y": 11259,
      "props": {
        "w": 296,
        "h": 87,
        "baseline": 20,
        "latex": "d_{\\theta}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n_{set}\\ge2\\\\\\quad\\left\\Vert\\displaystyle R-\\min\\left(p_{l1},p_{l2}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle R-\\min\\left(p_{l1}\\right)\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6n",
      "type": "text",
      "x": 76,
      "y": 11386,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Depth cA at pivot A/B boundary",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6o",
      "type": "math",
      "x": 400,
      "y": 11375,
      "props": {
        "w": 192,
        "h": 41,
        "baseline": 24,
        "latex": "c_{A}\\coloneq\\frac{\\varepsilon_{cu2}d_{\\theta}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6p",
      "type": "text",
      "x": 76,
      "y": 11466,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Depth yC of pivot C (εc2 in full compression)",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6q",
      "type": "math",
      "x": 400,
      "y": 11451,
      "props": {
        "w": 229,
        "h": 47,
        "baseline": 28,
        "latex": "y_{C}\\coloneq\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)D",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6r",
      "type": "text",
      "x": 76,
      "y": 11795,
      "props": {
        "w": 630,
        "h": 21,
        "html": "Strain plane (+ compression)",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_6s",
      "type": "text",
      "x": 76,
      "y": 11836,
      "props": {
        "w": 630,
        "h": 19,
        "html": "c = neutral-axis depth below the compression edge; p = fibre coordinate from the centroid along",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6t",
      "type": "text",
      "x": 76,
      "y": 11876,
      "props": {
        "w": 630,
        "h": 19,
        "html": "θM, so R − p = fibre depth. The plane pivots about A (extreme bar at −εud, c &lt; cA), B (edge at",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6u",
      "type": "text",
      "x": 76,
      "y": 11916,
      "props": {
        "w": 630,
        "h": 19,
        "html": "εcu2, c ≤ D) or C (εc2 at depth yC, c &gt; D), EC2 Fig. 6.1.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6v",
      "type": "text",
      "x": 76,
      "y": 12037,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Strain at fibre p for depth c",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6w",
      "type": "math",
      "x": 400,
      "y": 11950,
      "props": {
        "w": 218,
        "h": 183,
        "baseline": 20,
        "latex": "\\varepsilon\\left(c,p\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c<c_{A}\\\\\\quad\\left\\Vert\\displaystyle \\varepsilon_{ud}\\frac{c-R+p}{d_{\\theta}-c}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ c\\le D\\\\\\quad\\left\\Vert\\displaystyle \\varepsilon_{cu2}\\frac{c-R+p}{c}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\varepsilon_{c2}\\frac{c-R+p}{c-y_{C}}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6x",
      "type": "text",
      "x": 76,
      "y": 12155,
      "props": {
        "w": 630,
        "h": 21,
        "html": "Stress laws",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_6y",
      "type": "text",
      "x": 76,
      "y": 12257,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Concrete stress, parabola-rectangle (EC2 3.17), no tension",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_6z",
      "type": "math",
      "x": 400,
      "y": 12190,
      "props": {
        "w": 271,
        "h": 155,
        "baseline": 20,
        "latex": "\\sigma_{c}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\varepsilon\\le0\\\\\\quad\\left\\Vert\\displaystyle 0\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\varepsilon<\\varepsilon_{c2}\\\\\\quad\\left\\Vert\\displaystyle f_{cd}\\left(1-\\left(1-\\frac{\\varepsilon}{\\varepsilon_{c2}}\\right)^2\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_{cd}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_70",
      "type": "text",
      "x": 76,
      "y": 12437,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Steel stress, elastic-plastic within ±fyd",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_71",
      "type": "math",
      "x": 400,
      "y": 12370,
      "props": {
        "w": 200,
        "h": 126,
        "baseline": 20,
        "latex": "\\sigma_{s}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ E_{s}\\varepsilon<-f_{yd}\\\\\\quad\\left\\Vert\\displaystyle -f_{yd}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ E_{s}\\varepsilon>f_{yd}\\\\\\quad\\left\\Vert\\displaystyle f_{yd}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle E_{s}\\varepsilon\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_72",
      "type": "text",
      "x": 76,
      "y": 12517,
      "props": {
        "w": 310,
        "h": 18,
        "html": "Net bar stress (concrete it displaces subtracted)",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_73",
      "type": "math",
      "x": 400,
      "y": 12510,
      "props": {
        "w": 165,
        "h": 30,
        "baseline": 20,
        "latex": "\\sigma_{b}\\left(\\varepsilon\\right)\\coloneq\\sigma_{s}\\left(\\varepsilon\\right)-\\sigma_{c}\\left(\\varepsilon\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_74",
      "type": "text",
      "x": 76,
