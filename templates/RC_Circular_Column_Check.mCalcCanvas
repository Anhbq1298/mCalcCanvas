      "x": 96,
      "y": 6595,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "N_{R}\\left(c\\right)\\coloneq\\mathrm{sum}\\left(\\sigma_{c}\\left(\\varepsilon\\left(c,x_{c}\\right)\\right)A_{c}\\right)+A_{b1}\\mathrm{sum}\\left(\\sigma_{b}\\left(\\varepsilon\\left(c,p_{l1}\\right)\\right)\\right)+\\delta_{2}A_{b2}\\mathrm{sum}\\left(\\sigma_{b}\\left(\\varepsilon\\left(c,p_{l2}\\right)\\right)\\right)",
        "displayMode": "formula",
