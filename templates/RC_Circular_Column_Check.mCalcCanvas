      "x": 400,
      "y": 5474,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "c_{A}\\coloneq\\frac{\\varepsilon_{cu2}d_{\\theta}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4h",
      "type": "text",
      "x": 80,
      "y": 5535,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Depth yC of pivot C (εc2 in full compression)",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4i",
      "type": "math",
      "x": 400,
      "y": 5524,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "y_{C}\\coloneq\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)D",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4j",
      "type": "text",
      "x": 80,
      "y": 5584,
      "props": {
        "w": 630,
        "h": 24,
        "html": "5.2 Strain plane (+ compression)",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_4k",
      "type": "text",
      "x": 80,
      "y": 5614,
      "props": {
        "w": 630,
        "h": 24,
        "html": "c = neutral-axis depth below the compression edge; p = fibre coordinate from the centroid along",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4l",
      "type": "text",
      "x": 80,
      "y": 5644,
      "props": {
        "w": 630,
        "h": 24,
        "html": "θM, so R − p = fibre depth. The plane pivots about A (extreme bar at −εud, c &lt; cA), B (edge at",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4m",
      "type": "text",
      "x": 80,
      "y": 5674,
      "props": {
        "w": 630,
        "h": 24,
        "html": "εcu2, c ≤ D) or C (εc2 at depth yC, c &gt; D), EC2 Fig. 6.1.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4n",
      "type": "text",
      "x": 80,
      "y": 6014,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Strain at fibre p for depth c",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4o",
      "type": "math",
      "x": 400,
      "y": 5935,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon\\left(c,p\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c<c_{A}\\\\\\quad\\left\\Vert\\displaystyle \\varepsilon_{ud}\\frac{c-R+p}{d_{\\theta}-c}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ c\\le D\\\\\\quad\\left\\Vert\\displaystyle \\varepsilon_{cu2}\\frac{c-R+p}{c}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\varepsilon_{c2}\\frac{c-R+p}{c-y_{C}}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4p",
      "type": "text",
      "x": 80,
      "y": 6125,
      "props": {
        "w": 630,
        "h": 24,
        "html": "5.3 Stress laws",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_col_4q",
      "type": "text",
      "x": 80,
      "y": 6212,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Concrete stress, parabola-rectangle (EC2 3.17), no tension",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4r",
      "type": "math",
      "x": 400,
      "y": 6155,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{c}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\varepsilon\\le0\\\\\\quad\\left\\Vert\\displaystyle 0\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\varepsilon<\\varepsilon_{c2}\\\\\\quad\\left\\Vert\\displaystyle f_{cd}\\left(1-\\left(1-\\frac{\\varepsilon}{\\varepsilon_{c2}}\\right)^2\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_{cd}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4s",
      "type": "text",
      "x": 80,
      "y": 6375,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Steel stress, elastic-plastic within ±fyd",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4t",
      "type": "math",
      "x": 400,
      "y": 6325,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{s}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ E_{s}\\varepsilon<-f_{yd}\\\\\\quad\\left\\Vert\\displaystyle -f_{yd}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ E_{s}\\varepsilon>f_{yd}\\\\\\quad\\left\\Vert\\displaystyle f_{yd}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle E_{s}\\varepsilon\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_4u",
      "type": "text",
      "x": 80,
      "y": 6471,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Net bar stress (concrete it displaces subtracted)",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_col_4v",
      "type": "math",
      "x": 400,
      "y": 6465,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{b}\\left(\\varepsilon\\right)\\coloneq\\sigma_{s}\\left(\\varepsilon\\right)-\\sigma_{c}\\left(\\varepsilon\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
