    },
    {
      "id": "s_col_6d",
      "type": "math",
      "x": 296,
      "y": 7811,
      "props": {
        "w": 146,
        "h": 34,
        "baseline": 22,
        "latex": "A_{c}\\coloneq2\\sqrt{R^2-x_{c}^2}\\cdot\\Delta",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_col_6e",
      "type": "text",
      "x": 76,
      "y": 7862,
