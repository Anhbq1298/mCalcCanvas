      "props": {
        "w": 60,
        "h": 32,
        "latex": "F_{S}\\left(c,p,A\\right)\\coloneq\\left(\\sigma_{S}\\left(\\varepsilon\\left(c,p\\right)\\right)-\\sigma_{C}\\left(\\varepsilon\\left(c,p\\right)\\right)\\right)A",
