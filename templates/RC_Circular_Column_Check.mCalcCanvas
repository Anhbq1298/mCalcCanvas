        "h": 32,
        "latex": "V_{Rd.max}\\coloneq\\frac{\\alpha_{cw}b_{w}z\\nu_{1}f_{cd.v}}{\\mathrm{cot}_{\\theta}+\\tan\\left(\\theta\\right)}",
        "displayMode": "formulaResult",
