      "x": 76,
      "y": 2975,
      "props": {
        "w": 630,
        "h": 19,
        "html": "about its own axis acts; with the other moment present it is taken in uniform compression.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
