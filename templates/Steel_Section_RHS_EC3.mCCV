      }
    },
    {
      "id": "s_secrhs_3s",
      "type": "math",
      "x": 96,
      "y": 5287,
      "props": {
        "w": 461,
        "h": 165,
        "baseline": 16,
        "latex": "\\psi_{h}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left|M_{z.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\left|M_{y.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\land\\frac{N_{Ed}}{A}+\\frac{\\left|M_{y.Ed}\\right|c_{h}}{2I_{y}}>0\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle \\max\\left(-3,\\frac{\\frac{N_{Ed}}{A}-\\frac{\\left|M_{y.Ed}\\right|c_{h}}{2I_{y}}}{\\frac{N_{Ed}}{A}+\\frac{\\left|M_{y.Ed}\\right|c_{h}}{2I_{y}}}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
