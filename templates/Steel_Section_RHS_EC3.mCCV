      "props": {
        "w": 376,
        "h": 809,
        "baseline": 16,
        "latex": "f_{y.ps}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ t_{max}\\le16\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ t_{max}\\le40\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle \\begin{array}{||l}\\mathrm{if}\\ f_{y.nom}\\ge420\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-20\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-10\\,\\mathrm{MPa}\\right.\\end{array}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ t_{max}\\le63\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle \\begin{array}{||l}\\mathrm{if}\\ f_{y.nom}\\ge420\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-30\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-20\\,\\mathrm{MPa}\\right.\\end{array}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ t_{max}\\le80\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle \\begin{array}{||l}\\mathrm{if}\\ f_{y.nom}\\ge420\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-50\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ f_{y.nom}\\le235\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-20\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-30\\,\\mathrm{MPa}\\right.\\end{array}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\begin{array}{||l}\\mathrm{if}\\ f_{y.nom}\\ge420\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-60\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ f_{y.nom}\\le235\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-20\\,\\mathrm{MPa}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_{y.nom}-40\\,\\mathrm{MPa}\\right.\\end{array}\\right.\\end{array}",
