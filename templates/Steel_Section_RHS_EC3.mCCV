        "latex": "\\alpha_{b}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left|M_{y.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\left|M_{z.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(1,\\max\\left(0,0.5\\left(1+\\frac{N_{Ed}}{2c_{b}tf_{y}}\\right)\\right)\\right)\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ N_{Ed}>0\\,\\mathrm{kN}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
