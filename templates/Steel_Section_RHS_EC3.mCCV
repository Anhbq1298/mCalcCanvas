      "props": {
        "w": 277,
        "h": 99,
        "baseline": 16,
        "latex": "\\alpha\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n<0.8\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(6,\\frac{1.66}{1-1.13n^2}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 6\\right.\\end{array}",
