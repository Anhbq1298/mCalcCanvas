        "baseline": 16,
        "latex": "\\rho_{z}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\mathrm{UR}_{V.z}>0.5\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(0.99,\\left(2\\mathrm{UR}_{V.z}-1\\right)^2\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
