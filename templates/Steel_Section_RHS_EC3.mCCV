        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_secrhs_3q",
      "type": "math",
      "x": 96,
      "y": 5081,
      "props": {
        "w": 371,
        "h": 176,
        "baseline": 16,
        "latex": "\\alpha_{h}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left|M_{z.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\left|M_{y.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(1,\\max\\left(0,0.5\\left(1+\\frac{N_{Ed}}{2c_{h}tf_{y}}\\right)\\right)\\right)\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ N_{Ed}>0\\,\\mathrm{kN}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
