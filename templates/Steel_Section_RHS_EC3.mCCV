    {
      "id": "s_secrhs_9c",
      "type": "text",
      "x": 76,
      "y": 13429,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Hollow sections: not susceptible to torsional deformations, Table B.1. Class 3: elastic columns.",
        "fontFamily": "Roboto",
