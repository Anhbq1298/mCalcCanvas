    {
      "id": "s_secrhs_5p",
      "type": "math",
      "x": 96,
      "y": 7730,
      "props": {
        "w": 400,
        "h": 225,
        "baseline": 16,
        "latex": "\\mathrm{UR}_{pl}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n\\ge1\\\\\\quad\\left\\Vert\\displaystyle n\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ M_{z.Ed}=0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\left|M_{y.Ed}\\right|}{M_{N.y.Rd}}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ M_{y.Ed}=0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\left|M_{z.Ed}\\right|}{M_{N.z.Rd}}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\left(\\left(\\frac{\\left|M_{y.Ed}\\right|}{M_{N.y.Rd}}\\right)^{\\alpha}+\\left(\\frac{\\left|M_{z.Ed}\\right|}{M_{N.z.Rd}}\\right)^{\\alpha}\\right)^{\\frac{1}{\\alpha}}\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
