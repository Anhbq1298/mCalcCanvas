      "props": {
        "w": 227,
        "h": 117,
        "baseline": 16,
        "latex": "\\beta_{h1}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\alpha_{h}>0.5\\\\\\quad\\left\\Vert\\displaystyle \\frac{396}{13\\alpha_{h}-1}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\frac{36}{\\max\\left(\\alpha_{h},0.01\\right)}\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
