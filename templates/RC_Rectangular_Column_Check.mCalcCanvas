      "props": {
        "w": 60,
        "h": 32,
        "latex": "C_{o}\\left(b_{w},d,V\\right)\\coloneq C_{opt}\\left(a_{V}\\left(b_{w},d,V\\right)\\right)",
        "displayMode": "formula",
