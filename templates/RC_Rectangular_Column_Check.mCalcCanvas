      "props": {
        "w": 60,
        "h": 32,
        "latex": "M_{\\theta}\\left(u\\right)\\coloneq\\mathrm{linterp}\\left(\\mathrm{map}\\left(\\psi_{u},u,\\beta_{v}\\right),\\mathrm{map}\\left(M_{u},u,\\beta_{v}\\right),\\theta_{M}\\right)",
