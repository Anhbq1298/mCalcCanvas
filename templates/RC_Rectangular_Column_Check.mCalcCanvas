      "props": {
        "w": 630,
        "h": 24,
        "html": "5. STRAIN PLANE AND STRESS LAWS",
        "fontFamily": "Inter",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2
      }
    },
    {
      "id": "s_rect_3x",
      "type": "text",
      "x": 80,
      "y": 5464,
      "props": {
        "w": 630,
        "h": 24,
        "html": "c = neutral-axis depth below the compression face; p = fibre coordinate from the centroid;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3y",
      "type": "text",
      "x": 80,
      "y": 5494,
      "props": {
        "w": 630,
        "h": 24,
        "html": "H = section depth in the bending direction, so H/2 − p = fibre depth;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3z",
      "type": "text",
      "x": 80,
      "y": 5524,
      "props": {
        "w": 630,
        "h": 24,
        "html": "dt = depth of the extreme bar below the compression face.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_40",
      "type": "text",
      "x": 80,
      "y": 5566,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A: extreme bar at −εud",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_41",
      "type": "math",
      "x": 400,
      "y": 5554,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{A}\\left(c,p,H,d_{t}\\right)\\coloneq\\varepsilon_{ud}\\frac{c-\\frac{H}{2}+p}{d_{t}-c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_42",
      "type": "text",
      "x": 80,
      "y": 5625,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot B: compression face at εcu2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_43",
      "type": "math",
      "x": 400,
      "y": 5614,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{B}\\left(c,p,H\\right)\\coloneq\\varepsilon_{cu2}\\frac{c-\\frac{H}{2}+p}{c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_44",
      "type": "text",
      "x": 80,
      "y": 5955,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot C: εc2 at depth (1 − εc2/εcu2)·H",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_45",
      "type": "math",
      "x": 400,
      "y": 5935,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{C}\\left(c,p,H\\right)\\coloneq\\varepsilon_{c2}\\frac{c-\\frac{H}{2}+p}{c-\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)H}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_46",
      "type": "text",
      "x": 80,
      "y": 6024,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A/B boundary depth",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_47",
      "type": "math",
      "x": 400,
      "y": 6015,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "c_{AB}\\left(d_{t}\\right)\\coloneq\\frac{\\varepsilon_{cu2}d_{t}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_48",
      "type": "text",
      "x": 80,
      "y": 6069,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Pivot B or C (compression face or full compression)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_49",
      "type": "math",
      "x": 96,
      "y": 6095,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{BC}\\left(c,p,H\\right)\\coloneq\\mathrm{if}\\left(c\\le H,\\varepsilon_{B}\\left(c,p,H\\right),\\varepsilon_{C}\\left(c,p,H\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4a",
      "type": "text",
      "x": 80,
      "y": 6149,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Strain at fibre p (pivot chosen by c)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4b",
      "type": "math",
      "x": 96,
      "y": 6175,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon\\left(c,p,H,d_{t}\\right)\\coloneq\\mathrm{if}\\left(c<c_{AB}\\left(d_{t}\\right),\\varepsilon_{A}\\left(c,p,H,d_{t}\\right),\\varepsilon_{BC}\\left(c,p,H\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4c",
      "type": "text",
      "x": 80,
      "y": 6219,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Concrete strain argument u limited to 0 … εc2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4d",
      "type": "math",
      "x": 96,
      "y": 6255,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{k}\\left(u\\right)\\coloneq0.5\\left(0.5\\left(u+\\left|u\\right|\\right)+\\varepsilon_{c2}-\\left|0.5\\left(u+\\left|u\\right|\\right)-\\varepsilon_{c2}\\right|\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4e",
      "type": "text",
      "x": 80,
      "y": 6303,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Concrete stress at strain u (parabola-rectangle)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4f",
      "type": "math",
      "x": 400,
      "y": 6295,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{C}\\left(u\\right)\\coloneq f_{cd}\\left(1-\\left(1-\\frac{\\varepsilon_{k}\\left(u\\right)}{\\varepsilon_{c2}}\\right)^2\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4g",
      "type": "text",
      "x": 80,
      "y": 6369,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Steel stress at strain u (±fyd)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4h",
      "type": "math",
      "x": 96,
      "y": 6395,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{S}\\left(u\\right)\\coloneq0.5\\left(\\left|E_{s}u+f_{yd}\\right|-\\left|E_{s}u-f_{yd}\\right|\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4i",
      "type": "text",
      "x": 80,
