        "h": 32,
        "latex": "y_{s}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ k_{s}<n_{b}\\\\\\quad\\left\\Vert\\displaystyle a_{y}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ k_{s}<2n_{b}\\\\\\quad\\left\\Vert\\displaystyle -a_{y}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ k_{s}<2n_{b}+n_{h}-2\\\\\\quad\\left\\Vert\\displaystyle -a_{y}+\\left(k_{s}-2n_{b}+1\\right)s_{y}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle -a_{y}+\\left(k_{s}-2n_{b}-n_{h}+3\\right)s_{y}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
