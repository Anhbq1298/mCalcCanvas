      "id": "s_rect_8d",
      "type": "math",
      "x": 400,
      "y": 15983,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\alpha_{T}\\left(j\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ a_{T}\\left(j\\right)=0\\\\\\quad\\left\\Vert\\displaystyle 225-135w_{T}\\left(j\\right)\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ a_{T}\\left(j\\right)=4\\\\\\quad\\left\\Vert\\displaystyle -180-135w_{T}\\left(j\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 180-90a_{T}\\left(j\\right)-90w_{T}\\left(j\\right)\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
