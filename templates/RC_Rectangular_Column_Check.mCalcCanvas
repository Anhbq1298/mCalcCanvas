      "props": {
        "w": 60,
        "h": 32,
        "latex": "M_{Ry}\\left(c,\\beta\\right)\\coloneq A_{f}\\mathrm{sum}\\left(\\sigma_{f}\\left(c,\\beta\\right)x_{f}\\right)+A_{b}\\mathrm{sum}\\left(\\sigma_{b}\\left(c,\\beta\\right)x_{s}\\right)",
