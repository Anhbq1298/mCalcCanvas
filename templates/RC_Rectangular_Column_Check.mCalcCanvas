        "latex": "o_{e}\\left(j\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ u_{L}\\left(j\\right)=M_{L}-1\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
