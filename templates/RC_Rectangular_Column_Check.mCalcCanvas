      "props": {
        "w": 60,
        "h": 32,
        "latex": "t_{y}\\coloneq\\begin{array}{|l}\\mathrm{if}\\ N_{Ed}<0\\,\\mathrm{kN}\\\\\\quad\\displaystyle \\max\\left(1,\\min\\left(C_{CSA.y},C_{opt.y}\\right)\\right)\\\\\\mathrm{else}\\\\\\quad\\displaystyle C_{opt.y}\\end{array}",
