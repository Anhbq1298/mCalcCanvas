      "props": {
        "w": 60,
        "h": 32,
        "latex": "C_{opt}\\left(a_{v}\\right)\\coloneq\\min\\left(2.5,0.5\\left(a_{v}+\\sqrt{\\max\\left(a_{v}^2-4,0\\right)}\\right)\\right)",
        "displayMode": "formula",
