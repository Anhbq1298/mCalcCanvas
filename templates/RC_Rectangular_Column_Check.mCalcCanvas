        "w": 310,
        "h": 24,
        "html": "Depth to the extreme bar, bending about y",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4f",
      "type": "math",
      "x": 400,
      "y": 6025,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "d_{y}\\coloneq\\frac{b}{2}+a_{x}",
