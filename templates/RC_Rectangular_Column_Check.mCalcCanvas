      "props": {
        "w": 60,
        "h": 32,
        "latex": "q_{b}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ l_{b}>150\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{floor}\\left(\\frac{n_{b}-1}{4}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
