        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_3p",
      "type": "text",
      "x": 80,
      "y": 4884,
      "props": {
        "w": 630,
        "h": 24,
        "html": "5. STRAIN PLANE AND STRESS LAWS",
        "fontFamily": "Inter",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2
      }
    },
    {
      "id": "s_rect_3q",
      "type": "text",
      "x": 80,
      "y": 4914,
      "props": {
        "w": 630,
        "h": 24,
        "html": "c = neutral-axis depth below the compression face; p = fibre coordinate from the centroid;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3r",
      "type": "text",
      "x": 80,
      "y": 4944,
      "props": {
        "w": 630,
        "h": 24,
        "html": "H = section depth in the bending direction, so H/2 − p = fibre depth;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3s",
      "type": "text",
      "x": 80,
      "y": 4974,
      "props": {
        "w": 630,
        "h": 24,
        "html": "dt = depth of the extreme bar below the compression face.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3t",
      "type": "text",
      "x": 80,
      "y": 5016,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A: extreme bar at −εud",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3u",
      "type": "math",
      "x": 400,
      "y": 5004,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{A}\\left(c,p,H,d_{t}\\right)\\coloneq\\varepsilon_{ud}\\frac{c-\\frac{H}{2}+p}{d_{t}-c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_3v",
      "type": "text",
      "x": 80,
      "y": 5075,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot B: compression face at εcu2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3w",
      "type": "math",
      "x": 400,
      "y": 5064,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{B}\\left(c,p,H\\right)\\coloneq\\varepsilon_{cu2}\\frac{c-\\frac{H}{2}+p}{c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_3x",
      "type": "text",
      "x": 80,
      "y": 5144,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot C: εc2 at depth (1 − εc2/εcu2)·H",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_3y",
      "type": "math",
      "x": 400,
      "y": 5124,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{C}\\left(c,p,H\\right)\\coloneq\\varepsilon_{c2}\\frac{c-\\frac{H}{2}+p}{c-\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)H}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_3z",
      "type": "text",
      "x": 80,
      "y": 5213,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A/B boundary depth",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_40",
      "type": "math",
      "x": 400,
      "y": 5204,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "c_{AB}\\left(d_{t}\\right)\\coloneq\\frac{\\varepsilon_{cu2}d_{t}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_41",
      "type": "text",
      "x": 80,
      "y": 5268,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Strain at fibre p (pivot chosen by c)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_42",
      "type": "math",
      "x": 96,
      "y": 5294,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon\\left(c,p,H,d_{t}\\right)\\coloneq\\mathrm{if}\\left(c<c_{AB}\\left(d_{t}\\right),\\varepsilon_{A}\\left(c,p,H,d_{t}\\right),\\mathrm{if}\\left(c\\le H,\\varepsilon_{B}\\left(c,p,H\\right),\\varepsilon_{C}\\left(c,p,H\\right)\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_43",
      "type": "text",
      "x": 80,
      "y": 5338,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Concrete strain argument u limited to 0 … εc2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_44",
      "type": "math",
      "x": 96,
      "y": 5364,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{k}\\left(u\\right)\\coloneq0.5\\left(0.5\\left(u+\\left|u\\right|\\right)+\\varepsilon_{c2}-\\left|0.5\\left(u+\\left|u\\right|\\right)-\\varepsilon_{c2}\\right|\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_45",
      "type": "text",
      "x": 80,
      "y": 5422,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Concrete stress at strain u (parabola-rectangle)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_46",
      "type": "math",
      "x": 400,
      "y": 5414,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{C}\\left(u\\right)\\coloneq f_{cd}\\left(1-\\left(1-\\frac{\\varepsilon_{k}\\left(u\\right)}{\\varepsilon_{c2}}\\right)^2\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_47",
      "type": "text",
      "x": 80,
      "y": 5488,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Steel stress at strain u (±fyd)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_48",
      "type": "math",
      "x": 96,
      "y": 5514,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{S}\\left(u\\right)\\coloneq0.5\\left(\\left|E_{s}u+f_{yd}\\right|-\\left|E_{s}u-f_{yd}\\right|\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_49",
      "type": "text",
      "x": 80,
      "y": 5558,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Bar force at p (displaced concrete subtracted)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4a",
      "type": "math",
      "x": 96,
      "y": 5594,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "F_{S}\\left(c,p,H,d_{t}\\right)\\coloneq\\left(\\sigma_{S}\\left(\\varepsilon\\left(c,p,H,d_{t}\\right)\\right)-\\sigma_{C}\\left(\\varepsilon\\left(c,p,H,d_{t}\\right)\\right)\\right)A_{b}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4b",
      "type": "text",
      "x": 80,
      "y": 5935,
      "props": {
        "w": 630,
        "h": 24,
        "html": "6. N–M CURVES ABOUT x AND y",
        "fontFamily": "Inter",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2
      }
    },
    {
      "id": "s_rect_4c",
