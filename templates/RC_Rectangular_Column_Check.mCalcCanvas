      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\theta_{CSA}\\left(e\\right)\\coloneq\\left(29+7000\\min\\left(3\\cdot10^{-3},\\max\\left(-0.2\\cdot10^{-3},e\\right)\\right)\\right)^{\\circ}",
