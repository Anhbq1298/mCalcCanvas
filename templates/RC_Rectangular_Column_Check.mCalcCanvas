        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4h",
      "type": "math",
      "x": 400,
      "y": 7196,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon\\left(c,p,H,d_{t}\\right)\\coloneq\\begin{array}{|l}\\mathrm{if}\\ c<\\frac{\\varepsilon_{cu2}d_{t}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}\\\\\\quad\\displaystyle \\varepsilon_{ud}\\frac{c-\\frac{H}{2}+p}{d_{t}-c}\\\\\\mathrm{else}\\ \\mathrm{if}\\ c\\le H\\\\\\quad\\displaystyle \\varepsilon_{cu2}\\frac{c-\\frac{H}{2}+p}{c}\\\\\\mathrm{else}\\\\\\quad\\displaystyle \\varepsilon_{c2}\\frac{c-\\frac{H}{2}+p}{c-\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)H}\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4i",
      "type": "text",
      "x": 80,
      "y": 7490,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Concrete stress, parabola-rectangle (EC2 3.17), no tension",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4j",
      "type": "math",
      "x": 400,
      "y": 7426,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{c}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{|l}\\mathrm{if}\\ \\varepsilon\\le0\\\\\\quad\\displaystyle 0\\,\\mathrm{MPa}\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\varepsilon<\\varepsilon_{c2}\\\\\\quad\\displaystyle f_{cd}\\left(1-\\left(1-\\frac{\\varepsilon}{\\varepsilon_{c2}}\\right)^2\\right)\\\\\\mathrm{else}\\\\\\quad\\displaystyle f_{cd}\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4k",
      "type": "text",
      "x": 80,
      "y": 7662,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Steel stress, elastic-plastic within ±fyd",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4l",
      "type": "math",
      "x": 400,
      "y": 7606,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{s}\\left(\\varepsilon\\right)\\coloneq\\begin{array}{|l}\\mathrm{if}\\ E_{s}\\varepsilon<-f_{yd}\\\\\\quad\\displaystyle -f_{yd}\\\\\\mathrm{else}\\ \\mathrm{if}\\ E_{s}\\varepsilon>f_{yd}\\\\\\quad\\displaystyle f_{yd}\\\\\\mathrm{else}\\\\\\quad\\displaystyle E_{s}\\varepsilon\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
