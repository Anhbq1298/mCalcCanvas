      "x": 96,
      "y": 11009,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "C_{CSA}\\left(M,V,d\\right)\\coloneq\\frac{1}{\\tan\\left(\\theta_{CSA}\\left(\\varepsilon_{x}\\left(M,V,d\\right)\\right)\\right)}",
        "displayMode": "formula",
