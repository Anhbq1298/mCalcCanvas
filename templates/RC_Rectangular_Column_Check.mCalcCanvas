      "type": "math",
      "x": 96,
      "y": 8387,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "d_{\\beta}\\left(\\beta\\right)\\coloneq\\frac{H_{\\beta}\\left(\\beta\\right)}{2}-\\min\\left(x_{s}\\cos\\left(\\beta\\right)+y_{s}\\sin\\left(\\beta\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
