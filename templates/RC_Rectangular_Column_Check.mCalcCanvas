        "w": 60,
        "h": 32,
        "latex": "o_{T}\\left(j\\right)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ u_{T}\\left(j\\right)=0\\lor u_{T}\\left(j\\right)=M_{T}-1\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
