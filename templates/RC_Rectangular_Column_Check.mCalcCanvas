      "x": 80,
      "y": 5982,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Depth to the extreme bar, bending about x",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4d",
