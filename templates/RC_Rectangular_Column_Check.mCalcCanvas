    {
      "id": "s_rect_53",
      "type": "text",
      "x": 80,
      "y": 6615,
      "props": {
        "w": 630,
        "h": 24,
        "html": "4.5 Concrete strips",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_rect_54",
      "type": "text",
      "x": 80,
      "y": 6645,
      "props": {
        "w": 630,
        "h": 24,
        "html": "The concrete is cut into nc thin strips parallel to the neutral axis. Each strip carries the",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_55",
      "type": "text",
      "x": 80,
      "y": 6675,
      "props": {
        "w": 630,
        "h": 24,
        "html": "stress at its centre strain; summing strip forces (× lever arm) gives the concrete N and M.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_56",
      "type": "text",
      "x": 80,
      "y": 6712,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Strip index",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_57",
      "type": "math",
      "x": 400,
      "y": 6705,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "j\\coloneq\\mathrm{seq}\\left(0,n_{c}-1\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_58",
      "type": "text",
      "x": 80,
      "y": 6764,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Strip thickness across h (bending about x)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_59",
      "type": "math",
      "x": 400,
      "y": 6755,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\Delta_{h}\\coloneq\\frac{h}{n_{c}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5a",
      "type": "text",
      "x": 80,
      "y": 6814,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Strip thickness across b (bending about y)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5b",
      "type": "math",
      "x": 400,
      "y": 6805,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\Delta_{b}\\coloneq\\frac{b}{n_{c}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5c",
      "type": "text",
      "x": 80,
      "y": 7113,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Strip centre y (bending about x)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5d",
      "type": "math",
      "x": 400,
      "y": 7106,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "y_{c}\\coloneq\\frac{h}{2}-\\left(j+0.5\\right)\\Delta_{h}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5e",
      "type": "text",
      "x": 80,
      "y": 7163,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Strip centre x (bending about y)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5f",
      "type": "math",
      "x": 400,
      "y": 7156,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "x_{c}\\coloneq\\frac{b}{2}-\\left(j+0.5\\right)\\Delta_{b}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5g",
      "type": "text",
      "x": 80,
      "y": 7226,
      "props": {
        "w": 630,
        "h": 24,
        "html": "5. STRAIN PLANE AND STRESS LAWS",
        "fontFamily": "Inter",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2
      }
    },
    {
      "id": "s_rect_5h",
      "type": "text",
      "x": 80,
      "y": 7256,
      "props": {
        "w": 630,
        "h": 24,
        "html": "c = neutral-axis depth below the compression face; p = fibre coordinate from the centroid;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5i",
      "type": "text",
      "x": 80,
      "y": 7286,
      "props": {
        "w": 630,
        "h": 24,
        "html": "H = section depth in the bending direction, so H/2 − p = fibre depth;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5j",
      "type": "text",
      "x": 80,
      "y": 7316,
      "props": {
        "w": 630,
        "h": 24,
        "html": "dt = depth of the extreme bar below the compression face.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5k",
      "type": "text",
      "x": 80,
      "y": 7358,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A: extreme bar at −εud",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5l",
      "type": "math",
      "x": 400,
      "y": 7346,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{A}\\left(c,p,H,d_{t}\\right)\\coloneq\\varepsilon_{ud}\\frac{c-\\frac{H}{2}+p}{d_{t}-c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5m",
      "type": "text",
      "x": 80,
      "y": 7417,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot B: compression face at εcu2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5n",
      "type": "math",
      "x": 400,
      "y": 7406,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{B}\\left(c,p,H\\right)\\coloneq\\varepsilon_{cu2}\\frac{c-\\frac{H}{2}+p}{c}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5o",
      "type": "text",
      "x": 80,
      "y": 7486,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot C: εc2 at depth (1 − εc2/εcu2)·H",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5p",
      "type": "math",
      "x": 400,
      "y": 7466,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{C}\\left(c,p,H\\right)\\coloneq\\varepsilon_{c2}\\frac{c-\\frac{H}{2}+p}{c-\\left(1-\\frac{\\varepsilon_{c2}}{\\varepsilon_{cu2}}\\right)H}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5q",
      "type": "text",
      "x": 80,
      "y": 7555,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Pivot A/B boundary depth",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5r",
      "type": "math",
      "x": 400,
      "y": 7546,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "c_{AB}\\left(d_{t}\\right)\\coloneq\\frac{\\varepsilon_{cu2}d_{t}}{\\varepsilon_{cu2}+\\varepsilon_{ud}}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5s",
      "type": "text",
      "x": 80,
      "y": 7610,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Pivot B or C (compression face or full compression)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5t",
      "type": "math",
      "x": 96,
      "y": 7636,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{BC}\\left(c,p,H\\right)\\coloneq\\mathrm{if}\\left(c\\le H,\\varepsilon_{B}\\left(c,p,H\\right),\\varepsilon_{C}\\left(c,p,H\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5u",
      "type": "text",
      "x": 80,
      "y": 7680,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Strain at fibre p (pivot chosen by c)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5v",
      "type": "math",
      "x": 96,
      "y": 7706,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon\\left(c,p,H,d_{t}\\right)\\coloneq\\mathrm{if}\\left(c<c_{AB}\\left(d_{t}\\right),\\varepsilon_{A}\\left(c,p,H,d_{t}\\right),\\varepsilon_{BC}\\left(c,p,H\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5w",
      "type": "text",
      "x": 80,
      "y": 7760,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Concrete strain argument u limited to 0 … εc2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5x",
      "type": "math",
      "x": 96,
      "y": 7786,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{k}\\left(u\\right)\\coloneq0.5\\left(0.5\\left(u+\\left|u\\right|\\right)+\\varepsilon_{c2}-\\left|0.5\\left(u+\\left|u\\right|\\right)-\\varepsilon_{c2}\\right|\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5y",
      "type": "text",
      "x": 80,
      "y": 7834,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Concrete stress at strain u (parabola-rectangle)",
        "fontFamily": "Inter",
