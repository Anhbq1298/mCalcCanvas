      "x": 96,
      "y": 17965,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{f}\\left(c,\\beta\\right)\\coloneq\\sigma_{c}\\left(\\varepsilon\\left(c,x_{f}\\cos\\left(\\beta\\right)+y_{f}\\sin\\left(\\beta\\right),H_{\\beta}\\left(\\beta\\right),d_{\\beta}\\left(\\beta\\right)\\right)\\right)",
