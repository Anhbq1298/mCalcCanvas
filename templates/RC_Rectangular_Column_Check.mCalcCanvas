      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{x.y}\\coloneq\\frac{\\frac{\\max\\left(\\left|M_{Ed.x}\\right|,0.9V_{Ed.y}d_{y}\\right)}{0.9d_{y}}+V_{Ed.y}-0.5N_{Ed}}{E_{s}A_{s}}",
