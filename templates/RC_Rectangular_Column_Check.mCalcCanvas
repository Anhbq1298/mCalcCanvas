      "x": 400,
      "y": 4814,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "x_{c}\\coloneq\\frac{b}{2}-\\left(j+0.5\\right)\\Delta_{b}",
        "displayMode": "formula",
        "displayUnit": "",
