      }
    },
    {
      "id": "s_rect_4o",
      "type": "text",
      "x": 80,
      "y": 7846,
      "props": {
        "w": 630,
        "h": 24,
        "html": "The neutral axis is turned (angle β of its normal) until the resisting moment points along θ;",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4p",
      "type": "text",
      "x": 80,
      "y": 7876,
      "props": {
        "w": 630,
        "h": 24,
        "html": "this gives the P–Mθ curve at θ. No reduction to the principal axes.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4q",
      "type": "text",
      "x": 80,
      "y": 7910,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Resultant design moment",
