      "props": {
        "w": 60,
        "h": 32,
        "latex": "C_{T}\\left(M,V,b_{w},d\\right)\\coloneq\\max\\left(1,\\min\\left(C_{CSA}\\left(M,V,d\\right),C_{o}\\left(b_{w},d,V\\right)\\right)\\right)",
