      "props": {
        "w": 60,
        "h": 32,
        "latex": "N_{\\theta}\\left(u\\right)\\coloneq\\mathrm{linterp}\\left(\\mathrm{map}\\left(\\psi_{u},u,\\beta_{v}\\right),\\mathrm{map}\\left(N_{u},u,\\beta_{v}\\right),\\theta_{M}\\right)",
