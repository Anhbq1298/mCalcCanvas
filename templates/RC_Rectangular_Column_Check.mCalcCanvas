        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_b7",
      "type": "math",
      "x": 96,
      "y": 18846,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "M_{u}\\left(u,\\beta\\right)\\coloneq\\sqrt{\\left(M_{Rx}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)\\right)^2+\\left(M_{Ry}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)\\right)^2}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_b8",
      "type": "text",
      "x": 80,
      "y": 18898,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Moment direction, measured from β (no 0/360° jump)",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
