    {
      "id": "s_rect_5a",
      "type": "math",
      "x": 96,
      "y": 7536,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\mathrm{cot}_{\\theta min.y}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ N_{Ed}<0\\,\\mathrm{kN}\\\\\\quad\\left\\Vert\\displaystyle \\max\\left(1,k_{A}\\left(2.5-0.1\\cdot\\frac{\\left|N_{Ed}\\right|}{V_{Ed.y}}\\right)\\right)\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ x_{y}\\ge0.25d_{y}\\\\\\quad\\left\\Vert\\displaystyle 2.5k_{A}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\sigma_{cp}\\ge3\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle 3.0k_{A}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\left(2.5+0.5\\cdot\\frac{\\sigma_{cp}}{3\\,\\mathrm{MPa}}\\right)k_{A}\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5b",
      "type": "text",
      "x": 80,
      "y": 7738,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Design cotθ: cot θmin if the strut holds, else the root of τEd(cotθ + tanθ) = ν·fcd; 1: strut fails",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5c",
      "type": "math",
      "x": 96,
      "y": 7766,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\mathrm{cot}_{\\theta.y}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\tau_{Ed.y}\\left(\\mathrm{cot}_{\\theta min.y}+\\frac{1}{\\mathrm{cot}_{\\theta min.y}}\\right)\\le\\nu f_{cd}\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{cot}_{\\theta min.y}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ 2\\tau_{Ed.y}\\le\\nu f_{cd}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\nu f_{cd}}{2\\tau_{Ed.y}}+\\sqrt{\\left(\\frac{\\nu f_{cd}}{2\\tau_{Ed.y}}\\right)^2-1}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
