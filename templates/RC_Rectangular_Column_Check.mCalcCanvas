        "h": 32,
        "latex": "\\theta_{CSA.y}\\coloneq\\left(29+7000\\min\\left(3\\cdot10^{-3},\\max\\left(-0.2\\cdot10^{-3},\\varepsilon_{x.y}\\right)\\right)\\right)^{\\circ}",
