      "type": "math",
      "x": 400,
      "y": 18075,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{b}\\left(c,\\beta\\right)\\coloneq\\sigma_{s}\\left(\\varepsilon_{b}\\left(c,\\beta\\right)\\right)-\\sigma_{c}\\left(\\varepsilon_{b}\\left(c,\\beta\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
