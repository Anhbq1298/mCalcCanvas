    {
      "id": "s_rect_4g",
      "type": "text",
      "x": 80,
      "y": 6079,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Axial resistance, bending about x",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_4h",
      "type": "math",
      "x": 96,
      "y": 6105,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "N_{x}\\left(c\\right)\\coloneq\\mathrm{sum}\\left(\\sigma_{C}\\left(\\varepsilon\\left(c,y_{c},h,d_{x}\\right)\\right)\\right)b\\Delta_{h}+\\mathrm{sum}\\left(F_{S}\\left(c,y_{s},h,d_{x}\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_4i",
