      "type": "math",
      "x": 400,
      "y": 19126,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\beta_{\\theta}\\left(u\\right)\\coloneq\\mathrm{linterp}\\left(\\mathrm{map}\\left(\\psi_{u},u,\\beta_{v}\\right),\\beta_{v},\\theta_{M}\\right)",
        "displayMode": "formula",
        "displayUnit": "",
