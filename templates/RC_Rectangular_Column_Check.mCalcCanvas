      "props": {
        "w": 60,
        "h": 32,
        "latex": "M_{Rx}\\left(c,\\beta\\right)\\coloneq A_{f}\\mathrm{sum}\\left(\\sigma_{f}\\left(c,\\beta\\right)y_{f}\\right)+A_{b}\\mathrm{sum}\\left(\\sigma_{b}\\left(c,\\beta\\right)y_{s}\\right)",
        "displayMode": "formula",
