      }
    },
    {
      "id": "s_rect_9j",
      "type": "math",
      "x": 400,
      "y": 18125,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "j_{L}\\coloneq\\mathrm{seq}\\left(0,\\max\\left(n_{L},1\\right)M_{L}-1\\right)",
