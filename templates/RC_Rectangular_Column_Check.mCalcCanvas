      "props": {
        "w": 60,
        "h": 32,
        "latex": "Y_{L}\\left(j\\right)\\coloneq\\left(1-k_{L}\\left(j\\right)\\right)\\left(1-2a_{L}\\left(j\\right)\\right)a_{y}+\\delta_{w}\\sin\\left(\\frac{\\pi\\alpha_{L}\\left(j\\right)}{180}\\right)+\\frac{\\sqrt{2}}{2}L_{w}p_{y}\\left(j\\right)",
