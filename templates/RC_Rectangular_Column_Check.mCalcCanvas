      "type": "math",
      "x": 400,
      "y": 12310,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "x_{s}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ k_{s}<n_{b}\\\\\\quad\\left\\Vert\\displaystyle -a_{x}+k_{s}s_{x}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ k_{s}<2n_{b}\\\\\\quad\\left\\Vert\\displaystyle -a_{x}+\\left(k_{s}-n_{b}\\right)s_{x}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ k_{s}<2n_{b}+n_{h}-2\\\\\\quad\\left\\Vert\\displaystyle -a_{x}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle a_{x}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
