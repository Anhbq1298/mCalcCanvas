      "props": {
        "w": 60,
        "h": 32,
        "latex": "N_{u}\\left(u,\\beta\\right)\\coloneq N_{R}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
