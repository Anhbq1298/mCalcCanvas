      "type": "text",
      "x": 80,
      "y": 17785,
      "props": {
        "w": 630,
        "h": 24,
        "html": "For a neutral-axis direction β (normal of the axis, towards the compression face):",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
