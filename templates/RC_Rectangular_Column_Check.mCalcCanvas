      "y": 260,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Biaxial: neutral axis rotated until the moment points along MEd; P–Mθ curve at that direction.",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_6",
      "type": "text",
      "x": 80,
      "y": 290,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Utilisation ηR: ray from the origin through (MEd, NEd) to the curve (as MBColumn).",
