      "props": {
        "w": 60,
        "h": 32,
        "latex": "w_{T}\\left(j\\right)\\coloneq\\frac{\\min\\left(\\max\\left(u_{T}\\left(j\\right)-1-n_{a}a_{T}\\left(j\\right),0\\right),n_{a}-1\\right)}{n_{a}-1}",
