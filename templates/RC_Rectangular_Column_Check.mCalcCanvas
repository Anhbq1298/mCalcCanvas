      "type": "text",
      "x": 80,
      "y": 8281,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Strain in every bar",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_59",
      "type": "math",
      "x": 96,
      "y": 8307,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{b}\\left(c,\\beta\\right)\\coloneq\\varepsilon\\left(c,x_{s}\\cos\\left(\\beta\\right)+y_{s}\\sin\\left(\\beta\\right),H_{\\beta}\\left(\\beta\\right),d_{\\beta}\\left(\\beta\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5a",
      "type": "text",
      "x": 80,
      "y": 8357,
      "props": {
        "w": 310,
        "h": 24,
        "html": "Net bar stress (concrete it displaces subtracted)",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_5b",
      "type": "math",
      "x": 400,
      "y": 8357,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\sigma_{b}\\left(c,\\beta\\right)\\coloneq\\sigma_{s}\\left(\\varepsilon_{b}\\left(c,\\beta\\right)\\right)-\\sigma_{c}\\left(\\varepsilon_{b}\\left(c,\\beta\\right)\\right)",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_5c",
      "type": "text",
      "x": 80,
      "y": 8411,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Axial resistance",
        "fontFamily": "Inter",
        "fontSize": 13,
