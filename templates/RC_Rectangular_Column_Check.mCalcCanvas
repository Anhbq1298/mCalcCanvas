      }
    },
    {
      "id": "s_rect_61",
      "type": "math",
      "x": 96,
      "y": 8957,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\mathrm{cot}_{\\theta min.x}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ N_{Ed}<0\\,\\mathrm{kN}\\\\\\quad\\left\\Vert\\displaystyle \\max\\left(1,k_{A}\\left(2.5-0.1\\cdot\\frac{\\left|N_{Ed}\\right|}{V_{Ed.x}}\\right)\\right)\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ x_{x}\\ge0.25d_{x}\\\\\\quad\\left\\Vert\\displaystyle 2.5k_{A}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\sigma_{cp}\\ge3\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle 3.0k_{A}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\left(2.5+0.5\\cdot\\frac{\\sigma_{cp}}{3\\,\\mathrm{MPa}}\\right)k_{A}\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_rect_62",
      "type": "text",
      "x": 80,
      "y": 9450,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Design cotθ: cot θmin if the strut holds, else the root of τEd(cotθ + tanθ) = ν·fcd; 1: strut fails",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_63",
      "type": "math",
      "x": 96,
      "y": 9478,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\mathrm{cot}_{\\theta.x}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\tau_{Ed.x}\\left(\\mathrm{cot}_{\\theta min.x}+\\frac{1}{\\mathrm{cot}_{\\theta min.x}}\\right)\\le\\nu f_{cd}\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{cot}_{\\theta min.x}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ 2\\tau_{Ed.x}\\le\\nu f_{cd}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\nu f_{cd}}{2\\tau_{Ed.x}}+\\sqrt{\\left(\\frac{\\nu f_{cd}}{2\\tau_{Ed.x}}\\right)^2-1}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\end{array}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 2,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
