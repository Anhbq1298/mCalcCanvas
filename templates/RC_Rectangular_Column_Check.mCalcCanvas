    {
      "id": "s_rect_b9",
      "type": "math",
      "x": 96,
      "y": 18926,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\psi_{u}\\left(u,\\beta\\right)\\coloneq\\beta+\\arctan\\left(\\frac{M_{Rx}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)\\cos\\left(\\beta\\right)-M_{Ry}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)\\sin\\left(\\beta\\right)}{M_{Ry}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)\\cos\\left(\\beta\\right)+M_{Rx}\\left(uH_{\\beta}\\left(\\beta\\right),\\beta\\right)\\sin\\left(\\beta\\right)}\\right)",
        "displayMode": "formula",
