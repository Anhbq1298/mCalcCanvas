    {
      "id": "s_rect_b0",
      "type": "math",
      "x": 400,
      "y": 18375,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\beta_{v}\\coloneq\\left(\\frac{\\pi}{2}\\mathrm{floor}\\left(\\frac{2\\theta_{M}}{\\pi\\,\\mathrm{rad}}\\right)+\\frac{\\pi}{18}\\mathrm{seq}\\left(0,9\\right)\\right)\\mathrm{rad}",
        "displayMode": "formula",
