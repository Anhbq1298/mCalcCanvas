      "id": "s_rect_a0",
      "type": "text",
      "x": 76,
      "y": 19563,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Stress in every concrete fibre at depth c",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_a1",
      "type": "math",
      "x": 96,
      "y": 19596,
      "props": {
        "w": 60,
        "h": 32,
