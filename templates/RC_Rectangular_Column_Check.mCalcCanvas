      }
    },
    {
      "id": "s_rect_4r",
      "type": "math",
      "x": 96,
      "y": 7936,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "M_{Ed}\\coloneq\\sqrt{M_{Ed.x}^2+M_{Ed.y}^2}",
