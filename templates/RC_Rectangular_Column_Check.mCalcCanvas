      "props": {
        "w": 630,
        "h": 24,
        "html": "other bar are restrained, symmetric about the face centre.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_7d",
      "type": "text",
      "x": 80,
      "y": 12200,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Each mirrored pair is held by one inner closed tie; a single middle bar gets a cross-tie.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_7e",
      "type": "text",
