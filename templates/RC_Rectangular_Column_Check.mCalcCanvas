      "type": "text",
      "x": 80,
      "y": 15307,
      "props": {
        "w": 630,
        "h": 24,
        "html": "CSA εx with M ≥ V·dv, dv = 0.9d; tension-side steel As/2",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_9k",
      "type": "math",
      "x": 96,
      "y": 15333,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\varepsilon_{x}\\left(M,V,d\\right)\\coloneq\\frac{\\frac{\\max\\left(\\left|M\\right|,0.9Vd\\right)}{0.9d}+V-0.5N_{Ed}}{E_{s}A_{s}}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 18,
        "color": "#0f172a"
