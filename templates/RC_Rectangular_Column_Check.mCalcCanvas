      "props": {
        "w": 60,
        "h": 32,
        "latex": "H_{\\beta}\\left(\\beta\\right)\\coloneq b\\left|\\cos\\left(\\beta\\right)\\right|+h\\left|\\sin\\left(\\beta\\right)\\right|",
        "displayMode": "formula",
