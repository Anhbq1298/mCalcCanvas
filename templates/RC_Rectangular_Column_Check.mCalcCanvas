      "x": 96,
      "y": 8957,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "\\rho_{Rd}\\coloneq\\mathrm{linterp}\\left(\\frac{n_{v}}{\\sqrt{n_{v}^2+m_{v}^2}},\\sqrt{n_{v}^2+m_{v}^2},\\frac{n_{Ed}}{\\sqrt{n_{Ed}^2+m_{Ed}^2}}\\right)",
