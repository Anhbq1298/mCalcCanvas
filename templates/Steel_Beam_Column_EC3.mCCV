        "baseline": 18,
        "latex": "\\alpha_{w}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ M_{y.Ed}>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\land M_{z.Ed}=0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(1,0.5\\left(1+\\frac{N_{Ed}}{c_{w}t_{w}f_{y}}\\right)\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\end{array}",
