        "color": "#0f172a",
        "baseline": 20,
        "steelFigure": "buckling",
        "constant": true
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_304",
      "type": "text",
      "x": 76,
      "y": 10096,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Ideal elastic modes. Actual K depends on frame sway, connection stiffness and intermediate restraints.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_305",
      "type": "text",
      "x": 76,
      "y": 10128,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Fixed–guided: rotations restrained, relative translation free. Viewing this annex never changes Ky/Kz.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_306",
      "type": "text",
      "x": 76,
      "y": 10160,
      "props": {
        "w": 640,
        "h": 24,
        "html": "LTB k/kw are separate lateral-bending / warping factors. Complex frames require stability analysis.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
