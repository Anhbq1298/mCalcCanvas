        "latex": "\\mathrm{Class}_{f}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\beta_{f}\\le9\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\beta_{f}\\le10\\\\\\quad\\left\\Vert\\displaystyle 2\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\beta_{f}\\le14\\\\\\quad\\left\\Vert\\displaystyle 3\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 4\\right.\\end{array}",
