      "props": {
        "w": 410,
        "h": 32,
        "latex": "c_{w.2}\\coloneq \\operatorname{if}(\\alpha_{w.used}>0.5,456/(13\\alpha_{w.used}-1),41.5/\\operatorname{max}(\\alpha_{w.used},10^{-12}))\\epsilon",
        "displayMode": "formulaResult",
