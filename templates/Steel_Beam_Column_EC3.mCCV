    },
    {
      "id": "ec3_77",
      "type": "math",
      "x": 96,
      "y": 1763,
      "props": {
        "w": 280,
        "h": 32,
        "latex": "\\sigma_N\\coloneq N_{Ed}/A",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_78",
      "type": "math",
      "x": 396,
      "y": 1763,
      "props": {
        "w": 290,
        "h": 32,
        "latex": "\\sigma_M\\coloneq \\operatorname{abs}(M_{y.Ed})c_w/(2I_y)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 12,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_79",
      "type": "math",
      "x": 96,
      "y": 1807,
      "props": {
        "w": 280,
        "h": 32,
        "latex": "\\psi_w\\coloneq \\operatorname{if}(\\sigma_N+\\sigma_M>0\\,\\mathrm{MPa},\\operatorname{max}(-3,(\\sigma_N-\\sigma_M)/(\\sigma_N+\\sigma_M)),-3)",
        "displayMode": "result",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_80",
      "type": "math",
      "x": 396,
      "y": 1807,
      "props": {
        "w": 290,
        "h": 32,
        "latex": "\\alpha_w\\coloneq \\operatorname{min}(1,\\operatorname{max}(0,(1+N_{Ed}/(c_wt_wf_{y}))/2))",
        "displayMode": "result",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_81",
      "type": "text",
      "x": 76,
      "y": 1847,
      "props": {
        "w": 640,
        "h": 24,
        "html": "ψ=(σN−σM)/(σN+σM); α=min[1,max(0,(1+NEd/(cw tw fy))/2)].",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_82",
      "type": "math",
      "x": 96,
      "y": 1887,
      "props": {
        "w": 280,
        "h": 32,
        "latex": "\\alpha_{w.used}\\coloneq \\operatorname{if}(M_{z.Ed}=0\\,\\mathrm{N}\\cdot\\mathrm{mm},\\operatorname{if}(\\operatorname{abs}(M_{y.Ed})>0\\,\\mathrm{N}\\cdot\\mathrm{mm},\\alpha_w,1),1)",
        "displayMode": "result",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_83",
      "type": "text",
      "x": 396,
      "y": 1887,
      "props": {
        "w": 290,
        "h": 24,
        "html": "Biaxial case: use α=1 (uniform compression).",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_84",
      "type": "text",
      "x": 76,
      "y": 1927,
      "props": {
        "w": 210,
        "h": 24,
        "html": "Web limit for Class 1",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
