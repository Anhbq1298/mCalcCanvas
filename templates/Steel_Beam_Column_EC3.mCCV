      "props": {
        "w": 290,
        "h": 32,
        "latex": "\\lambda_w\\coloneq c_w/t_w",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
