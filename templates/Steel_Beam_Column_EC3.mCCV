        "latex": "\\psi_w\\coloneq \\operatorname{if}(\\sigma_N+\\sigma_M>0\\,\\mathrm{MPa},\\operatorname{max}(-3,(\\sigma_N-\\sigma_M)/(\\sigma_N+\\sigma_M)),-3)",
