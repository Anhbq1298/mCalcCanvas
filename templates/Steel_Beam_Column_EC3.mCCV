      "y": 1679,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Flange Class 1 / 2 / 3 limits: 9ε / 10ε / 14ε. Uniform compression is conservative.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-1"
    },
