      "props": {
        "w": 280,
        "h": 32,
        "latex": "c_w\\coloneq h-2(t_f+r)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
