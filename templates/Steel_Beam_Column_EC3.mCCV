    {
      "id": "ec3_300",
      "type": "text",
      "x": 76,
      "y": 10599,
      "props": {
        "w": 640,
        "h": 28,
        "html": "ANNEX B — LTB LOAD CASES AND COEFFICIENTS",
        "fontFamily": "Inter",
        "fontSize": 19,
        "color": "#1e3a5f",
        "align": "left",
        "annex": {
          "kind": "heading",
          "id": "ltb-cases"
        }
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_301",
      "type": "text",
      "x": 76,
      "y": 10631,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Enter the case number shown below. Coefficients are for k = kw = 1; load-height zg is entered on page 1.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_302",
      "type": "math",
      "x": 76,
      "y": 10655,
      "props": {
        "w": 634,
        "h": 680,
        "latex": "\\mathrm{LTBcatalog}\\coloneq \\operatorname{stack}(\\mathrm{LTBcase})",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20,
        "steelFigure": "ltbCatalog"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_303",
      "type": "text",
      "x": 76,
      "y": 11375,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Cases 1–9: SCI NCCI SN003b Table 3.1, end-moment ratio ψ = smaller / larger end moment; C2 = 0.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_304",
      "type": "text",
      "x": 76,
      "y": 11407,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Cases 10–13: Table 3.2 transverse loading. Fixed-end cases use their own coefficients; do not substitute pin-ended values.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_305",
      "type": "text",
      "x": 76,
      "y": 11439,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Combined end moments plus transverse loading require SN003b §3.4 curves and ψ/μ. They are not silently interpolated here.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_306",
      "type": "text",
      "x": 76,
      "y": 11471,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Outside cases 1–13, or k/kw ≠ 1, returns NOT VERIFIED unless verified manual coefficients or external Mcr are supplied.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_307",
      "type": "text",
      "x": 76,
      "y": 11503,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Reference: SCI NCCI SN003b, Tables 3.1/3.2, §§2–3.3. End restraints and load position must match.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-9"
    },
    {
      "id": "ec3_308",
      "type": "text",
      "x": 76,
      "y": 11770,
      "props": {
        "w": 640,
        "h": 28,
        "html": "ANNEX C — LTB COEFFICIENT TABLE",
        "fontFamily": "Inter",
        "fontSize": 19,
        "color": "#1e3a5f",
        "align": "left",
        "heading": 1
      },
