      }
    },
    {
      "id": "s_stl_9y",
      "type": "text",
      "x": 76,
      "y": 13504,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Cm inputs: Table B.3, using the moment diagram between the relevant braced points.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_9z",
      "type": "text",
      "x": 76,
      "y": 13529,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Default Cmy = Cmz = CmLT = 1.0; no moment-gradient benefit is taken.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_a0",
      "type": "text",
      "x": 76,
      "y": 13560,
      "props": {
        "w": 630,
        "h": 24,
        "html": "Method applicability - detailed validation",
