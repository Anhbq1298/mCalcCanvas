      "x": 76,
      "y": 7821,
      "props": {
        "w": 540,
        "h": 122,
        "baseline": 18,
        "latex": "\\delta_{LT}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n_{LT}=0\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ n_{LT}=\\mathrm{floor}\\left(n_{LT}\\right)\\land n_{LT}\\ge1\\land n_{LT}\\le13\\land k=1\\land k_{w}=1\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
