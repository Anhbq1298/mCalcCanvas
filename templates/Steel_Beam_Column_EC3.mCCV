        }
      }
    },
    {
      "id": "s_stl_a1",
      "type": "text",
      "x": 76,
      "y": 13590,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Flags: 1 = supported; 0 = invalid input or separate verification required.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_a2",
      "type": "text",
      "x": 76,
      "y": 13615,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Axial compression and nonnegative shear magnitudes",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_a3",
      "type": "math",
      "x": 76,
      "y": 13639,
      "props": {
        "w": 352,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{forces}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(N_{Ed},V_{y.Ed},V_{z.Ed}\\right)\\ge0\\,\\mathrm{kN}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_a4",
      "type": "text",
      "x": 76,
      "y": 13728,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Nonnegative moment magnitudes",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_a5",
      "type": "math",
      "x": 76,
      "y": 13752,
      "props": {
        "w": 362,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{moments}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(M_{y.Ed},M_{z.Ed}\\right)\\ge0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_a6",
      "type": "text",
      "x": 76,
      "y": 13846,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Valid action signs",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_a7",
      "type": "math",
      "x": 396,
      "y": 13841,
      "props": {
        "w": 193,
        "h": 26,
        "baseline": 18,
        "latex": "\\delta_{actions}\\coloneq\\delta_{forces}\\delta_{moments}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_a8",
      "type": "text",
      "x": 76,
      "y": 14157,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Positive material stiffness and strength",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_a9",
      "type": "math",
      "x": 396,
      "y": 14112,
      "props": {
        "w": 301,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{elastic}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(f_y,E,G\\right)>0\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_aa",
      "type": "text",
      "x": 76,
      "y": 14246,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Positive partial factors and shear-area factor",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_ab",
      "type": "math",
      "x": 396,
      "y": 14201,
      "props": {
        "w": 283,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{factors}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(\\gamma_{M0},\\gamma_{M1},\\eta\\right)>0\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_ac",
      "type": "text",
      "x": 76,
      "y": 14290,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Valid material inputs (also fy ≤ 460 MPa above)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_ad",
      "type": "math",
      "x": 76,
      "y": 14314,
      "props": {
        "w": 355,
        "h": 26,
        "baseline": 18,
        "latex": "\\delta_{material}\\coloneq\\delta_{elastic}\\delta_{factors}\\mathrm{if}\\left(f_y\\le460\\,\\mathrm{MPa},1,0\\right)",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_ae",
      "type": "text",
      "x": 76,
      "y": 14346,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Positive buckling lengths (SN003b)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_af",
      "type": "math",
      "x": 76,
      "y": 14370,
      "props": {
        "w": 374,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{lengths}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(L_{cr.y},L_{cr.z},L_{cr.T},L_{LT}\\right)>0\\,\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_ag",
      "type": "text",
      "x": 76,
      "y": 14504,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Positive end factors (SN003b)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_ah",
      "type": "math",
      "x": 396,
      "y": 14459,
      "props": {
        "w": 225,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{ends}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(k,k_w\\right)>0\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_ai",
      "type": "text",
      "x": 76,
      "y": 14548,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Valid I/H dimensions, excluding fillets or welds",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_aj",
      "type": "math",
      "x": 76,
      "y": 14572,
      "props": {
        "w": 559,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{geometry}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\min\\left(h-2t_f-2r,b-t_w-2r,t_w,t_f\\right)>0\\,\\mathrm{mm}\\land r\\ge0\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_ak",
      "type": "text",
      "x": 76,
      "y": 14706,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Positive selected C1 (SN003b)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_al",
      "type": "math",
      "x": 396,
      "y": 14661,
      "props": {
        "w": 159,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{C1}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ C_1>0\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_am",
      "type": "text",
      "x": 76,
      "y": 14750,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Cm factors in Table B.3 range",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_an",
      "type": "math",
      "x": 76,
      "y": 14774,
      "props": {
        "w": 614,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{Cm}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ C_{my}\\ge0.4\\land C_{my}\\le1\\land C_{mz}\\ge0.4\\land C_{mz}\\le1\\land C_{mLT}\\ge0.4\\land C_{mLT}\\le1\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_ao",
      "type": "text",
      "x": 76,
      "y": 14863,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Section: Class ≤ 3; compression web not Class 4 (Table 5.2)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_ap",
      "type": "math",
      "x": 76,
      "y": 14887,
      "props": {
        "w": 394,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{section}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\mathrm{Class}\\le3\\land\\left(N_{Ed}\\equiv0\\,\\mathrm{kN}\\lor\\beta_w\\le42\\right)\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_aq",
      "type": "text",
      "x": 76,
      "y": 14976,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Table 6.2 rolled geometry range, or welded section",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_ar",
      "type": "math",
      "x": 76,
      "y": 15000,
      "props": {
        "w": 395,
        "h": 83,
        "baseline": 18,
        "latex": "\\delta_{curves}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\mathrm{Section}=0\\lor t_f\\le100\\,\\mathrm{mm}\\lor\\frac{h}{b}\\le1.2\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_stl_as",
      "type": "text",
      "x": 76,
      "y": 15089,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Web shear buckling excluded (§6.2.6); one shear direction only",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_stl_at",
      "type": "math",
      "x": 76,
      "y": 15283,
      "props": {
        "w": 450,
        "h": 85,
        "baseline": 18,
        "latex": "\\delta_{shear}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\frac{h-2t_f}{t_w}\\le\\frac{72\\varepsilon}{\\eta}\\land\\left(V_{y.Ed}\\equiv0\\,\\mathrm{kN}\\lor V_{z.Ed}\\equiv0\\,\\mathrm{kN}\\right)\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
