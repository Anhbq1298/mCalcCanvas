      "props": {
        "w": 640,
        "h": 24,
        "html": "EN 1993-1-1 §5.5 / Table 5.2. Biaxial loading: uniform web compression is conservative.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_68",
      "type": "text",
      "x": 76,
      "y": 1499,
      "props": {
        "w": 210,
        "h": 24,
        "html": "Material factor ε = √(235 MPa / fy)",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
      "id": "ec3_69",
      "type": "math",
      "x": 300,
      "y": 1499,
      "props": {
        "w": 410,
        "h": 86,
        "latex": "\\epsilon\\coloneq \\sqrt{\\frac{235\\,\\mathrm{MPa}}{f_{y}}}",
        "displayMode": "full",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 12,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-1"
    },
    {
