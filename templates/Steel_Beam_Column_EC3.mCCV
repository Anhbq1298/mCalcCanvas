      "y": 1635,
      "props": {
        "w": 290,
        "h": 32,
        "latex": "\\mathrm{Class}_f\\coloneq \\operatorname{if}(\\lambda_f\\le9\\epsilon,1,\\operatorname{if}(\\lambda_f\\le10\\epsilon,2,\\operatorname{if}(\\lambda_f\\le14\\epsilon,3,4)))",
        "displayMode": "result",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
