      "y": 9193,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Modes: LTB 0 auto / 1 manual / 2 external; SLS 0 simple / 1 cantilever / 2 external.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-7"
    },
    {
      "id": "ec3_301",
      "type": "text",
      "x": 76,
      "y": 9225,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Manual kij, Cm and curves require independent verification; acknowledgement flags persist in .mCCV.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-7"
    },
    {
      "id": "ec3_302",
      "type": "text",
