      "y": 9848,
      "props": {
        "w": 640,
        "h": 28,
        "html": "BUCKLING K — REFERENCE ONLY",
        "fontFamily": "Inter",
        "fontSize": 14,
        "color": "#1e3a5f",
        "align": "left",
        "heading": 2,
        "annex": {
          "kind": "heading",
          "id": "buckling-k"
        }
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_303",
      "type": "math",
      "x": 96,
      "y": 9884,
      "props": {
        "w": 620,
        "h": 204,
        "latex": "\\mathrm{Kreference}\\coloneq 1",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
