      "type": "math",
      "x": 96,
      "y": 5120,
      "props": {
        "w": 600,
        "h": 32,
        "latex": "M_{cr}\\coloneq \\operatorname{entry}(\\mathrm{R},24)",
        "displayMode": "result",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
