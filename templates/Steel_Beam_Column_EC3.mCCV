      "props": {
        "w": 640,
        "h": 24,
        "html": "Use this expression only for verified configurations; external mode uses the supplied Mcr.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_179",
      "type": "text",
      "x": 76,
      "y": 5192,
      "props": {
        "w": 210,
        "h": 24,
        "html": "Relative LTB slenderness λLT",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_180",
      "type": "math",
      "x": 300,
      "y": 5192,
      "props": {
        "w": 410,
        "h": 32,
        "latex": "\\lambda_{LT}\\coloneq \\operatorname{if}(M_{cr}>0\\,\\mathrm{N}\\cdot\\mathrm{mm},\\sqrt{W_yf_{y}/M_{cr}},0)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 12,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_181",
      "type": "math",
      "x": 96,
      "y": 5244,
      "props": {
        "w": 280,
        "h": 32,
        "latex": "\\Phi_{LT}\\coloneq 0.5\\left(1+\\alpha_{LT}(\\lambda_{LT}-0.2)+\\lambda_{LT}^2\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 12,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_182",
      "type": "math",
      "x": 396,
      "y": 5244,
      "props": {
        "w": 290,
        "h": 32,
        "latex": "\\chi_{LT}\\coloneq \\operatorname{if}(M_{cr}>0\\,\\mathrm{N}\\cdot\\mathrm{mm},\\operatorname{min}\\left(1,\\frac{1}{\\Phi_{LT}+\\sqrt{\\operatorname{max}(0,\\Phi_{LT}^2-\\lambda_{LT}^2)}}\\right),0)",
        "displayMode": "result",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_183",
      "type": "text",
      "x": 76,
      "y": 5292,
      "props": {
        "w": 210,
        "h": 24,
        "html": "LTB resistance Mb,Rd (6.3.2.2)",
        "fontFamily": "Inter",
