        "heading": 2
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_320",
      "type": "text",
      "x": 76,
      "y": 10236,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Class 4, plated shear buckling, biaxial shear, arbitrary LTB and Annex A require separate verification.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_321",
      "type": "text",
      "x": 76,
      "y": 10268,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Automatic Annex B: Class 1/2, λz ≥ 0.4. Other branches need independently verified manual kij.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_322",
      "type": "text",
      "x": 76,
      "y": 10300,
      "props": {
        "w": 640,
        "h": 24,
        "html": "No applied torsion, fatigue, connections or block tearing. High-shear member interaction is unverified.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
      "id": "ec3_323",
      "type": "text",
      "x": 76,
      "y": 10332,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Catalogue properties include source approximations; review project tables. UB/UC: custom entry only.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-8"
    },
    {
