      "type": "text",
      "x": 76,
      "y": 5288,
      "props": {
        "w": 640,
        "h": 24,
        "html": "No applied torsion. Connections, block tearing and fatigue excluded; Lt specified independently.",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-4"
    },
