      "x": 300,
      "y": 5292,
      "props": {
        "w": 410,
        "h": 32,
        "latex": "M_{b.Rd}\\coloneq \\frac{\\chi_{LT}W_yf_{y}}{\\gamma_{M1}}",
        "displayMode": "formulaResult",
