      "type": "text",
      "x": 76,
      "y": 5256,
      "props": {
        "w": 640,
        "h": 24,
        "html": "Annex B auto: Class 1/2, λz ≥ 0.4; other cases require independently verified manual kij.",
        "fontFamily": "Inter",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-4"
    },
