        "baseline": 21,
        "latex": "\\max\\left(1-\\frac{0.1\\lambda_z n_z}{C_{mLT}-0.25},1-\\frac{0.1n_z}{C_{mLT}-0.25}\\right)",
        "displayMode": "formula",
