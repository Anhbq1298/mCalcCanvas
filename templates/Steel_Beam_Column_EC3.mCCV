      "props": {
        "w": 640,
        "h": 24,
        "html": "λLT = √(Wy fy / Mcr). Without a verified Mcr, LTB is NOT VERIFIED.",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
