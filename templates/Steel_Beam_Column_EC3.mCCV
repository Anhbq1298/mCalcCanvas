      "y": 1635,
      "props": {
        "w": 280,
        "h": 32,
        "latex": "c_{f.1}\\coloneq 9\\epsilon",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 13,
        "color": "#0f172a",
        "baseline": 20
      },
