    },
    {
      "id": "ec3_173",
      "type": "text",
      "x": 76,
      "y": 4980,
      "props": {
        "w": 210,
        "h": 24,
        "html": "Torsion and warping term Bcr",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_174",
      "type": "math",
      "x": 300,
      "y": 4980,
      "props": {
        "w": 410,
        "h": 32,
        "latex": "B_{cr}\\coloneq \\left(\\frac{\\mathrm{k}}{\\mathrm{kw}}\\right)^2\\frac{I_w}{I_z}+\\frac{\\mathrm{G}I_t}{T_{cr}}+(C_{2.used}\\mathrm{zg})^2",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 12,
        "color": "#0f172a",
        "baseline": 20
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_175",
      "type": "text",
      "x": 76,
      "y": 5028,
      "props": {
        "w": 210,
        "h": 24,
        "html": "Elastic critical moment Mcr",
        "fontFamily": "Inter",
        "fontSize": 11,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "ec3-sheet-4"
    },
    {
      "id": "ec3_176",
      "type": "math",
      "x": 300,
      "y": 5028,
      "props": {
        "w": 410,
        "h": 86,
        "latex": "M_{cr.calc}\\coloneq C_{1.used}T_{cr}\\left(\\sqrt{B_{cr}}-C_{2.used}\\mathrm{zg}\\right)",
        "displayMode": "full",
        "displayUnit": "",
        "precision": -1,
        "textFont": "Inter",
        "equationFont": "Math",
        "fontStyle": "normal",
        "autoSize": true,
        "fontSize": 12,
        "color": "#0f172a",
        "baseline": 20
      },
