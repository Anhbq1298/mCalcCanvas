      "x": 96,
      "y": 1591,
      "props": {
        "w": 280,
        "h": 32,
        "latex": "c_f\\coloneq \\frac{b-t_w-2r}{2}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
