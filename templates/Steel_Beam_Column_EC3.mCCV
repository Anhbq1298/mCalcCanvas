      "x": 300,
      "y": 1927,
      "props": {
        "w": 410,
        "h": 32,
        "latex": "c_{w.1}\\coloneq \\operatorname{if}(\\alpha_{w.used}>0.5,396/(13\\alpha_{w.used}-1),36/\\operatorname{max}(\\alpha_{w.used},10^{-12}))\\epsilon",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": -1,
