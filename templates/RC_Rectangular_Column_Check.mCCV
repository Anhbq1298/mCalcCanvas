    {
      "id": "s_rect_6p",
      "type": "text",
      "x": 76,
      "y": 9723,
      "props": {
        "w": 630,
        "h": 23,
        "html": "No inner ties when every bar is within 150 mm of a corner bar. Otherwise corners and every",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_6q",
      "type": "text",
      "x": 76,
      "y": 9752,
      "props": {
        "w": 630,
        "h": 23,
        "html": "other bar are restrained, symmetric about the face centre.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_6r",
      "type": "text",
      "x": 76,
      "y": 9781,
      "props": {
        "w": 630,
        "h": 23,
        "html": "Each mirrored pair is held by one inner closed tie; a single middle bar gets a cross-tie.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_rect_6s",
      "type": "text",
      "x": 76,
      "y": 9810,
      "props": {
        "w": 630,
        "h": 23,
        "html": "Every unrestrained bar is next to a restrained one, so a bar spacing ≤ 150 mm suffices.",
        "fontFamily": "Inter",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
