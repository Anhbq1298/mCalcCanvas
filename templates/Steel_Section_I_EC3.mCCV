      "props": {
        "w": 472,
        "h": 124,
        "baseline": 18,
        "latex": "\\psi_{w}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left|M_{y.Ed}\\right|>0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\land\\frac{N_{Ed}}{A}+\\frac{\\left|M_{y.Ed}\\right|c_{w}}{2I_{y}}>0\\,\\mathrm{MPa}\\\\\\quad\\left\\Vert\\displaystyle \\max\\left(-3,\\frac{\\frac{N_{Ed}}{A}-\\frac{\\left|M_{y.Ed}\\right|c_{w}}{2I_{y}}}{\\frac{N_{Ed}}{A}+\\frac{\\left|M_{y.Ed}\\right|c_{w}}{2I_{y}}}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\end{array}",
