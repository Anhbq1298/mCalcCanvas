      "props": {
        "w": 630,
        "h": 19,
        "html": "SN003b Tables 3.1 / 3.2; k = kw = 1 and κ = 0 (conservative C1). No interpolation of cases.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
