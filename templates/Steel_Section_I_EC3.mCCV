      "id": "s_seci_4l",
      "type": "math",
      "x": 396,
      "y": 6279,
      "props": {
        "w": 235,
        "h": 79,
        "baseline": 16,
        "latex": "\\mathrm{UR}_{sec}\\coloneq \\begin{array}{||l}\\mathrm{if}\\ \\mathrm{Class}\\le2\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{UR}_{pl}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{UR}_{el}\\right.\\end{array}",
        "displayMode": "formulaResult",
