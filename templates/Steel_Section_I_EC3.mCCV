        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_seci_4k",
      "type": "text",
      "x": 76,
      "y": 6322,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Class 1, 2: plastic; Class 3: elastic",
        "fontFamily": "Roboto",
        "fontSize": 12,
