      "x": 96,
      "y": 7296,
      "props": {
        "w": 531,
        "h": 101,
        "baseline": 17,
        "latex": "M_{N.y.Rd}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left|N_{Ed}\\right|\\le0.25N_{V.Rd}\\land\\left|N_{Ed}\\right|\\le 0.5h_{w}t_{w}\\frac{f_{y}\\left(1-\\rho\\right)}{\\gamma_{M0}}\\\\\\quad\\left\\Vert\\displaystyle M_{pl.y.Rd}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(M_{pl.y.Rd},M_{pl.y.Rd}\\frac{1-n}{1-0.5a}\\right)\\right.\\end{array}",
        "displayMode": "auto",
