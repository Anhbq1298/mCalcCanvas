      "id": "s_seci_7k",
      "type": "text",
      "x": 76,
      "y": 10194,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Mcr: SCI NCCI SN003b eq. (1), fork supports, k = kw = 1. L_LT = 0: no LTB (χ_LT = 1).",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_7l",
      "type": "text",
      "x": 76,
      "y": 10219,
      "props": {
        "w": 630,
        "h": 24,
