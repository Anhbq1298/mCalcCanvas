        "baseline": 16,
        "latex": "\\alpha_{y}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\mathrm{Section}=0\\land t_f\\le40\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 0.34\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\mathrm{Section}=0\\\\\\quad\\left\\Vert\\displaystyle 0.49\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\frac{h}{b}>1.2\\land t_f\\le40\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 0.21\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ t_f\\le100\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 0.34\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0.76\\right.\\end{array}",
