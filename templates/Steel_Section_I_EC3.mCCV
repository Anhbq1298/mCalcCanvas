      "props": {
        "w": 290,
        "h": 37,
        "baseline": 23,
        "latex": "M_{pl.z.Rd}\\coloneq\\frac{W_{pl.z}f_{y}\\left(1-\\rho\\right)}{\\gamma_{M0}}",
        "displayMode": "formulaResult",
        "displayUnit": "kN m",
        "precision": 1,
