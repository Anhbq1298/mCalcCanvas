        "w": 450,
        "h": 116,
        "baseline": 19,
        "latex": "M_{N.z.Rd}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left(\\left|N_{Ed}\\right|\\le h_{w}t_{w}\\frac{f_{y}\\left(1-\\rho\\right)}{\\gamma_{M0}}\\right)\\lor\\left(n\\le a\\right)\\\\\\quad\\left\\Vert\\displaystyle M_{pl.z.Rd}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle M_{pl.z.Rd}\\left(1-\\left(\\frac{n-a}{1-a}\\right)^2\\right)\\right.\\end{array}",
