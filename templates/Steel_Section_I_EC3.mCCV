    },
    {
      "id": "s_seci_7m",
      "type": "text",
      "x": 76,
      "y": 10249,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Case valid: 0, or a whole number 1 to 13",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_7n",
      "type": "math",
      "x": 96,
      "y": 10273,
      "props": {
        "w": 415,
        "h": 118,
        "baseline": 16,
        "latex": "\\delta_{LT}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n_{LT}=0\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ n_{LT}=\\mathrm{floor}\\left(n_{LT}\\right)\\land n_{LT}\\ge1\\land n_{LT}\\le13\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
