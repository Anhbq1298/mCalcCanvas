      "type": "text",
      "x": 76,
      "y": 14839,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Support symbols show bending restraints; lateral movement and twist are restrained at both ends.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
