      "type": "text",
      "x": 76,
      "y": 5165,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Web depth between flanges",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_42",
      "type": "math",
      "x": 396,
      "y": 5162,
      "props": {
        "w": 163,
        "h": 22,
        "baseline": 16,
        "latex": "h_{w}\\coloneq h-2t_{f}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 0,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_43",
      "type": "text",
      "x": 76,
      "y": 5201,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Web area ratio (6.36)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_44",
      "type": "math",
      "x": 396,
      "y": 5190,
      "props": {
        "w": 241,
        "h": 39,
        "baseline": 24,
        "latex": "a\\coloneq\\min\\left(\\frac{A-2bt_{f}}{A},0.5\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_45",
      "type": "text",
      "x": 76,
      "y": 5235,
      "props": {
        "w": 630,
        "h": 18,
        "html": "About y: no reduction when (6.33) and (6.34) hold; else (6.36)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_46",
      "type": "math",
      "x": 96,
      "y": 5259,
      "props": {
        "w": 531,
        "h": 101,
        "baseline": 17,
        "latex": "M_{N.y.Rd}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left|N_{Ed}\\right|\\le0.25N_{V.Rd}\\land\\left|N_{Ed}\\right|\\le 0.5h_{w}t_{w}\\frac{f_{y}\\left(1-\\rho\\right)}{\\gamma_{M0}}\\\\\\quad\\left\\Vert\\displaystyle M_{pl.y.Rd}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(M_{pl.y.Rd},M_{pl.y.Rd}\\frac{1-n}{1-0.5a}\\right)\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "kN m",
        "precision": 1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_47",
      "type": "text",
      "x": 76,
      "y": 5366,
      "props": {
        "w": 630,
        "h": 18,
        "html": "About z: no reduction when (6.35) holds or n ≤ a; else (6.38)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_48",
      "type": "math",
      "x": 96,
      "y": 5390,
      "props": {
        "w": 438,
        "h": 116,
        "baseline": 19,
        "latex": "M_{N.z.Rd}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ \\left(\\left|N_{Ed}\\right|\\le h_{w}t_{w}\\frac{f_{y}\\left(1-\\rho\\right)}{\\gamma_{M0}}\\right)\\lor\\left(n\\le a\\right)\\\\\\quad\\left\\Vert\\displaystyle M_{pl.z.Rd}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle M_{pl.z.Rd}\\left(1-\\left(\\frac{n-a}{1-a}\\right)^2\\right)\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "kN m",
        "precision": 1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_49",
      "type": "text",
      "x": 76,
      "y": 5515,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Exponents (6.41), I and H sections",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_4a",
      "type": "math",
      "x": 396,
      "y": 5512,
      "props": {
        "w": 38,
        "h": 22,
        "baseline": 16,
        "latex": "\\alpha\\coloneq2",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_4b",
      "type": "text",
      "x": 76,
      "y": 5543,
      "props": {
        "w": 304,
        "h": 18,
        "html": "",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_4c",
      "type": "math",
      "x": 396,
      "y": 5540,
      "props": {
        "w": 166,
        "h": 22,
        "baseline": 16,
        "latex": "\\beta\\coloneq\\max\\left(5n,1\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_4d",
      "type": "text",
      "x": 76,
      "y": 5568,
      "props": {
        "w": 630,
        "h": 19,
        "html": "One moment only: (6.31) M_Ed/M_N,Rd ≤ 1. Both moments: (6.41) biaxial criterion.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_4e",
      "type": "text",
      "x": 76,
      "y": 5593,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Utilisation, plastic (n ≥ 1: axial force alone exceeds the resistance)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_4f",
      "type": "math",
      "x": 96,
      "y": 5915,
      "props": {
        "w": 375,
        "h": 223,
        "baseline": 16,
        "latex": "\\mathrm{UR}_{pl}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n\\ge1\\\\\\quad\\left\\Vert\\displaystyle n\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ M_{z.Ed}=0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\left|M_{y.Ed}\\right|}{M_{N.y.Rd}}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ M_{y.Ed}=0\\,\\mathrm{kN}\\cdot\\mathrm{m}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\left|M_{z.Ed}\\right|}{M_{N.z.Rd}}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\left(\\frac{\\left|M_{y.Ed}\\right|}{M_{N.y.Rd}}\\right)^{\\alpha}+\\left(\\frac{\\left|M_{z.Ed}\\right|}{M_{N.z.Rd}}\\right)^{\\beta}\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_seci_4g",
      "type": "text",
      "x": 76,
      "y": 6150,
      "props": {
        "w": 630,
        "h": 21,
        "html": "6.2 Class 3: elastic stresses (§6.2.9.2, (6.42))",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_seci_4h",
      "type": "text",
      "x": 76,
      "y": 6177,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Peak normal stress over f_y(1 − ρ)/γM0",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_seci_4i",
      "type": "math",
      "x": 96,
      "y": 6201,
      "props": {
        "w": 422,
        "h": 39,
        "baseline": 23,
        "latex": "\\mathrm{UR}_{el}\\coloneq\\frac{\\left|N_{Ed}\\right|}{N_{V.Rd}}+\\frac{\\left|M_{y.Ed}\\right|\\gamma_{M0}}{W_{el.y}f_{y}\\left(1-\\rho\\right)}+\\frac{\\left|M_{z.Ed}\\right|\\gamma_{M0}}{W_{el.z}f_{y}\\left(1-\\rho\\right)}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
