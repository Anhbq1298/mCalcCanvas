      "props": {
        "w": 336,
        "h": 83,
        "baseline": 18,
        "latex": "h_A\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c_{tap}\\ge1\\land h_{A.in}>0\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(h_{A.in},h_{a.lib}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle h_{a.lib}\\right.\\end{array}",
        "displayMode": "auto",
