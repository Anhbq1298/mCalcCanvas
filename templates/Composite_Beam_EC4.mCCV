      "props": {
        "w": 310,
        "h": 83,
        "baseline": 18,
        "latex": "f_{u.e}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c_{tr}\\ge1\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(f_u,450\\,\\mathrm{MPa}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle f_u\\right.\\end{array}",
