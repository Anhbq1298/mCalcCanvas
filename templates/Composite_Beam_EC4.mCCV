      "y": 31333,
      "props": {
        "w": 630,
        "h": 19,
        "html": "EN 1994-1-1 §6.4.1(1): a steel flange attached to the slab by shear connection to §6.6 may be",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
