      "x": 76,
      "y": 25538,
      "props": {
        "w": 630,
        "h": 19,
        "html": "SCI P405 (2015) §4.2.1: studs counted from the support to the maximum moment. P364 not checked.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_nz",
