    {
      "id": "s_ec4_m1",
      "type": "text",
      "x": 76,
      "y": 18310,
      "props": {
        "w": 636,
        "h": 16,
        "html": "Symbolic. Blue: concrete depth <i>x</i><sub>c</sub>; red: steel PNA <i>y</i><sub>a</sub>, a separate axis (flange or web branch).",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#64748b",
        "align": "left"
      },
      "groupId": "s_ec4_group_h4"
    },
    {
      "id": "s_ec4_m2",
      "type": "text",
      "x": 76,
      "y": 18328,
      "props": {
        "w": 636,
        "h": 16,
        "html": "The branch and all values are calculated in section 9.2; the design <i>M</i><sub>Rd</sub> uses EC4 (6.3).",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#64748b",
        "align": "left"
      },
      "groupId": "s_ec4_group_h4"
    },
    {
      "id": "s_ec4_m3",
      "type": "text",
      "x": 76,
      "y": 18350,
      "props": {
        "w": 630,
        "h": 24,
        "html": "",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#2563eb",
        "align": "left",
        "annex": {
          "kind": "link",
          "target": "pna"
        }
      }
    },
    {
      "id": "s_ec4_m4",
      "type": "text",
      "x": 76,
      "y": 18386,
      "props": {
        "w": 630,
        "h": 21,
        "html": "4.5 Studs and resistance along the span (§6.6.1.3)",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_ec4_m5",
      "type": "text",
      "x": 76,
      "y": 18413,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Shear spans run from each support to x_M; a large point load moves x_M and the stud counts.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_m6",
      "type": "text",
      "x": 76,
      "y": 18438,
      "props": {
        "w": 630,
        "h": 19,
        "html": "If the studs that fit cannot reach η_min, see chapter 6 (non-composite alternative).",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_m7",
      "type": "text",
      "x": 76,
      "y": 18475,
      "props": {
        "w": 304,
        "h": 18,
        "html": "η needed at x_M (not below η_min)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_m7"
    },
    {
      "id": "s_ec4_m8",
      "type": "math",
      "x": 396,
      "y": 18463,
      "props": {
        "w": 302,
        "h": 43,
        "baseline": 25,
        "latex": "\\eta_{req}\\coloneq \\max\\left(\\eta_{min},\\frac{M_{2.Ed}-M_{a.Rd}}{M_{pl.Rd}-M_{a.Rd}}\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
      "printGroupId": "s_ec4_pg_m7"
    },
    {
      "id": "s_ec4_m9",
      "type": "text",
      "x": 76,
      "y": 18525,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Studs needed in each shear span",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_m9"
    },
    {
      "id": "s_ec4_ma",
      "type": "math",
      "x": 396,
      "y": 18512,
      "props": {
        "w": 197,
        "h": 43,
        "baseline": 26,
        "latex": "n_{req}\\coloneq \\mathrm{ceil}\\left(\\frac{\\eta_{req}N_{c.f}}{P_{Rd}}\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
      "printGroupId": "s_ec4_pg_m9"
    },
    {
