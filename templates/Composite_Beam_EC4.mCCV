      "props": {
        "w": 630,
        "h": 21,
        "html": "3.3 Lateral-torsional buckling (§6.3.2.3 with the Singapore NA, or §6.3.2.2 with recommended values; Mcr from SCI SN003b or the page FE)",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_ec4_9l",
      "type": "text",
      "x": 76,
      "y": 9084,
      "props": {
        "w": 630,
        "h": 19,
        "html": "No restraint credit from wet slab or formwork. Unbraced: fork ends over L; braced: fork at each brace, L_LT = k_LT L, moments of the span L.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
