      "x": 76,
      "y": 31383,
      "props": {
        "w": 630,
        "h": 19,
        "html": "L_LT is then the stud spacing (χ_LT = 1). Otherwise the full span is used as unrestrained.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_x9",
      "type": "text",
