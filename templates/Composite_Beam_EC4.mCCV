        "latex": "h_B\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c_{tap}\\ge1\\land h_{B.in}>0\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle \\min\\left(h_{B.in},h_{a.lib}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle h_{a.lib}\\right.\\end{array}",
