        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_rh"
    },
    {
      "id": "s_ec4_ri",
      "type": "math",
      "x": 96,
      "y": 26470,
      "props": {
        "w": 347,
        "h": 26,
        "baseline": 18,
        "latex": "x_M\\coloneq \\mathrm{at}\\left(x_v,\\mathrm{at}\\left(\\mathrm{match}\\left(\\max\\left(M_v\\right),M_v\\right),0\\right)\\right)",
