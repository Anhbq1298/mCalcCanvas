      "id": "s_ec4_3a",
      "type": "math",
      "x": 96,
      "y": 2530,
      "props": {
        "w": 172,
        "h": 34,
        "baseline": 21,
        "latex": "g_0\\coloneq g_a+g_c",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
