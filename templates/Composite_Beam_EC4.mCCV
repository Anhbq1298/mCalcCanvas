        "baseline": 18,
        "latex": "\\alpha_{LT}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c_{wI}\\ge1\\land\\frac{h_a}{b_a}\\le2\\\\\\quad\\left\\Vert\\displaystyle 0.49\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ c_{wI}\\ge1\\\\\\quad\\left\\Vert\\displaystyle 0.76\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ c_{NA}\\ge1\\land\\frac{h_a}{b_a}\\le2\\\\\\quad\\left\\Vert\\displaystyle 0.34\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ c_{NA}\\ge1\\land\\frac{h_a}{b_a}\\le3.1\\\\\\quad\\left\\Vert\\displaystyle 0.49\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ c_{NA}\\ge1\\\\\\quad\\left\\Vert\\displaystyle 0.76\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ \\frac{h_a}{b_a}\\le2\\\\\\quad\\left\\Vert\\displaystyle 0.21\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0.34\\right.\\end{array}",
        "displayMode": "auto",
