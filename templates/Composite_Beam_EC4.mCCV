        "h": 86,
        "baseline": 47,
        "latex": "c_\\theta(v)\\coloneq\\min\\left(2,\\max\\left(1,\\frac{\\frac{0.999v_{max}}{v}+\\sqrt{\\max\\left(\\left(\\frac{0.999v_{max}}{v}\\right)^2-4,0\\right)}}{2}\\right)\\right)",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
