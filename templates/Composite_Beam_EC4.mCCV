      "y": 14573,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Shear spans: support A to the maximum moment (x_M) and x_M to support B; with a large point",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_h6",
      "type": "text",
      "x": 76,
      "y": 14598,
      "props": {
        "w": 630,
        "h": 19,
        "html": "load x_M moves to the load, so each span gets its own uniform spacing (EC4 §6.6.1.3(3)).",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
