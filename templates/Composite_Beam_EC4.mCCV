      "props": {
        "w": 291,
        "h": 160,
        "baseline": 18,
        "latex": "k_{t.max}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ n_r\\le1\\land t_p\\le1\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 0.85\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ n_r\\le1\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ t_p\\le1\\,\\mathrm{mm}\\\\\\quad\\left\\Vert\\displaystyle 0.7\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0.8\\right.\\end{array}",
