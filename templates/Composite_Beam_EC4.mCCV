      "props": {
        "w": 406,
        "h": 26,
        "baseline": 18,
        "latex": "V_{2.Ed}\\coloneq \\max\\left(\\mathrm{at}\\left(V_v,0\\right),-\\mathrm{at}\\left(V_v,\\mathrm{last}\\left(V_v\\right)\\right)\\right)",
