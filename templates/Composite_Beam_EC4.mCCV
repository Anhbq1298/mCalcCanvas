      }
    },
    {
      "id": "s_ec4_rc",
      "type": "text",
      "x": 76,
      "y": 24979,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Walking vibration: f1 = 18 / sqrt(δ), δ in mm, the midspan deflection under the mass loads (G + ψ_vib Q, self-weight included).",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_rd",
      "type": "text",
      "x": 76,
      "y": 25004,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Dynamic section: uncracked, full interaction. Default E_c.dyn = 38 GPa for normal-weight concrete: SCI P354 (Design of floors for vibration, 2009) and SCI AD 433; the 10% enhancement is not applied. Other practice: AISC DG11 uses 1.35 E_cm (about 44.6 GPa for C30/37); 1.0 E_cm gives the lower bound. Light-weight concrete: use the project or supplier value. Concrete in the ribs is not counted. Edit E_c.dyn in 1.10 to follow another standard.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_re",
      "type": "text",
      "x": 76,
      "y": 25057,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Dynamic modular ratio",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_re"
    },
