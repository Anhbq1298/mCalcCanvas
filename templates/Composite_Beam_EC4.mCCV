      "props": {
        "w": 171,
        "h": 103,
        "baseline": 18,
        "latex": "\\eta_x\\coloneq \\begin{array}{||l}\\mathrm{if}\\ n_x P_{Rd}\\ge N_{c.f}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\frac{n_x P_{Rd}}{N_{c.f}}\\right.\\end{array}",
