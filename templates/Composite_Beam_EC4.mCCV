      "props": {
        "w": 420,
        "h": 121,
        "baseline": 18,
        "latex": "M_v\\coloneq \\begin{array}{||l}\\mathrm{if}\\ c_{NA}\\ge1\\\\\\quad\\left\\Vert\\displaystyle k_{G.M}g_0\\frac{x_v\\left(L-x_v\\right)}{2}+\\mathrm{map}\\left(M_s,x_v,k_{G.M},k_{Q.M}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\gamma_{G.sw}g_0\\frac{x_v\\left(L-x_v\\right)}{2}+M_{U.v}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "kN m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
