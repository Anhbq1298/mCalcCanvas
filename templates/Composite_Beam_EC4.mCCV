        "w": 630,
        "h": 18,
        "html": "Maximum design shear (support)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_141"
    },
    {
      "id": "s_ec4_142",
      "type": "math",
      "x": 96,
