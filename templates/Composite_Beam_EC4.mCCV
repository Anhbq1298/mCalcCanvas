        "html": "Design moments under the point loads",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_nc"
    },
    {
      "id": "s_ec4_nd",
      "type": "math",
      "x": 96,
