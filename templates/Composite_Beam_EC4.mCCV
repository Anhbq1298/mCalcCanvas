      "type": "text",
      "x": 76,
      "y": 28264,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Elastic NA below slab top",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_tk"
    },
    {
      "id": "s_ec4_tl",
      "type": "math",
      "x": 96,
      "y": 28292,
      "props": {
        "w": 351,
        "h": 43,
        "baseline": 25,
        "latex": "y_{dyn}\\coloneq \\frac{A_a\\left(h_c+h_a/2\\right)+A_{c.dyn}h_t/2}{A_a+A_{c.dyn}}",
        "displayMode": "formulaResult",
        "displayUnit": "mm",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
      "printGroupId": "s_ec4_pg_tk"
    },
    {
