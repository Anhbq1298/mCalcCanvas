    },
    {
      "id": "s_ec4_11j",
      "type": "text",
      "x": 76,
      "y": 25379,
      "props": {
        "w": 630,
        "h": 19,
        "html": "SCI / European steel partners: Steel Buildings in Europe, Part 10, Technical Software Specification.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_11k",
      "type": "text",
      "x": 76,
      "y": 25404,
      "props": {
        "w": 630,
        "h": 19,
        "html": "SCI P359 §4.2, P405 §1.1, P364 Ex. 8: methodology cross-checks; text not re-verified in Rev D.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_11l",
      "type": "text",
      "x": 76,
      "y": 25429,
      "props": {
        "w": 630,
        "h": 19,
        "html": "SCI section tables / Steel Designers Manual: UB 406 x 178 x 60; rounded published properties.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_11m",
      "type": "text",
      "x": 76,
      "y": 25454,
      "props": {
        "w": 630,
        "h": 19,
        "html": "SCI NCCI SN003b: Mcr and UDL C1/C2; fork supports and top-flange loading.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_11n",
      "type": "text",
      "x": 76,
      "y": 25479,
      "props": {
        "w": 630,
        "h": 19,
        "html": "EC4 §§5.4.1.2, 5.4.2.2, 6.2.1.2, 6.2.1.3 (6.3), 6.2.2.4, 6.6.1.2 (6.12), 6.6.5, 6.6.6, 7.3.1.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
