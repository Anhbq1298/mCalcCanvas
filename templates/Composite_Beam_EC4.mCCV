    },
    {
      "id": "s_ec4_hr",
      "type": "text",
      "x": 76,
      "y": 14776,
      "props": {
        "w": 630,
        "h": 19,
        "html": "STATUS: REVIEW DRAFT. LTB and transverse reinforcement failures are retained, not waived.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_hs",
      "type": "text",
      "x": 76,
      "y": 14801,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Release gates: Singapore NAs; staged shrinkage/creep; SLS slip; local splitting/anchorage; welds.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_ht",
      "type": "text",
      "x": 76,
      "y": 14826,
      "props": {
        "w": 630,
        "h": 19,
        "html": "The main bending calculation applies to the verified full-connection slab-PNA branch only.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_hu",
      "type": "text",
      "x": 76,
      "y": 14851,
      "props": {
        "w": 630,
        "h": 19,
        "html": "General steel-PNA equations are annex derivations, not an implemented automatic branch solver.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_hv",
      "type": "text",
      "x": 76,
      "y": 14876,
      "props": {
        "w": 630,
        "h": 24,
        "html": "",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#2563eb",
        "align": "left",
        "annex": {
          "kind": "link",
          "target": "sources"
        }
      }
    },
    {
      "id": "s_ec4_hw",
      "type": "text",
      "x": 76,
      "y": 14918,
      "props": {
        "w": 630,
        "h": 29,
        "html": "ANNEX",
        "fontFamily": "Roboto",
        "fontSize": 20,
        "color": "#1e3a5f",
        "align": "left",
        "heading": 1,
        "annex": {
          "kind": "start"
        }
      }
    },
    {
      "id": "s_ec4_hx",
      "type": "text",
      "x": 76,
      "y": 14959,
      "props": {
        "w": 630,
        "h": 24,
        "html": "General plastic equilibrium and admissible PNA branches",
        "fontFamily": "Roboto",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2,
        "annex": {
          "kind": "heading",
          "id": "pna"
        }
      }
    },
    {
      "id": "s_ec4_hy",
      "type": "text",
      "x": 76,
      "y": 14995,
      "props": {
        "w": 630,
        "h": 21,
        "html": "A.1 General force model — y measured down from top of steel",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_ec4_hz",
      "type": "text",
      "x": 76,
      "y": 15022,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Width w_a(y) includes root fillets from the chosen section; Aa and Wpl alone do not locate PNA.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_i0",
      "type": "text",
      "x": 76,
      "y": 15054,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Compressed steel area above steel PNA",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_i1",
      "type": "math",
      "x": 396,
      "y": 15047,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "A_{ac}(y)=\\int_0^y w_a(z)\\,\\mathrm{d}z",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_i2",
      "type": "text",
      "x": 76,
      "y": 15290,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Equilibrium for available concrete force",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_i3",
      "type": "math",
      "x": 396,
      "y": 15283,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "2f_{yd}A_{ac}(y_a)+N_c=A_a f_{yd}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_i4",
      "type": "text",
      "x": 76,
      "y": 15321,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Compressed steel first moment about slab top",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_i5",
      "type": "math",
      "x": 96,
      "y": 15345,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "Q_{ac}(y)=\\int_0^y\\left(h_c+z\\right)w_a(z)\\,\\mathrm{d}z",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_i6",
      "type": "text",
      "x": 76,
      "y": 15383,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Common-axis moment equilibrium; concrete centroid at xc/2",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_i7",
      "type": "math",
      "x": 96,
      "y": 15407,
      "props": {
        "w": 60,
        "h": 32,
        "latex": "M_{Rd}=f_{yd}A_a\\left(h_c+\\frac{h_a}{2}\\right)-2f_{yd}Q_{ac}(y_a)-\\frac{N_c x_c}{2}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": -1,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_i8",
      "type": "text",
      "x": 76,
      "y": 15445,
      "props": {
        "w": 630,
        "h": 19,
        "html": "This direct stress-block solution is a reference derivation; main design uses linear interaction.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_i9",
      "type": "text",
      "x": 76,
      "y": 15476,
      "props": {
        "w": 630,
        "h": 21,
        "html": "A.2 Admissible steel PNA branches",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_ec4_ia",
      "type": "text",
      "x": 76,
      "y": 15503,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Top flange: 0 &lt;= Aac &lt;= ba tf; ya = Aac/ba. Root fillet transition follows flange.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_ib",
      "type": "text",
      "x": 76,
      "y": 15528,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Web: after flange and fillet area; solve cumulative actual steel area above ya.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_ic",
      "type": "text",
      "x": 76,
      "y": 15553,
      "props": {
        "w": 630,
        "h": 19,
        "html": "For a sharp-corner I only: ya = tf + (Aac - ba tf)/tw in the web.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_id",
      "type": "text",
      "x": 76,
      "y": 15578,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Do not combine the sharp-corner formula with rolled section area including fillets.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_ie",
      "type": "text",
      "x": 76,
      "y": 15603,
      "props": {
        "w": 630,
        "h": 19,
        "html": "At Nc &gt;= 0 and zero applied axial force, Aac &lt;= Aa/2: steel PNA cannot pass mid-depth.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_if",
      "type": "text",
      "x": 76,
      "y": 15628,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Lower flange is inadmissible for this symmetric, sagging, zero-axial-force configuration.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_ig",
      "type": "text",
      "x": 76,
      "y": 16454,
      "props": {
        "w": 630,
        "h": 21,
        "html": "D06 — Admissible branch: steel PNA in upper flange",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      },
      "groupId": "s_ec4_group_ig"
