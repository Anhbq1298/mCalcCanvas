        "baseline": 18,
        "latex": "h_a\\coloneq\\begin{array}{||l}\\mathrm{if}\\ d_{use}>0\\\\\\quad\\left\\Vert\\displaystyle d_{use}\\,\\mathrm{mm}\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\frac{h_A+h_B}{2}\\right.\\end{array}",
