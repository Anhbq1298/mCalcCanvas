    {
      "id": "s_ec4_2y",
      "type": "text",
      "x": 76,
      "y": 2465,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Self weight of the steel g_a, wet slab g_c and their sum g_0 (carried in every stage):",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_2z",
      "type": "math",
      "x": 96,
      "y": 2490,
      "props": {
        "w": 221,
        "h": 34,
        "baseline": 21,
        "latex": "g_a\\coloneq m_a\\cdot9.81\\,\\mathrm{m/s^2}",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_30",
      "type": "math",
      "x": 436,
      "y": 2490,
      "props": {
        "w": 165,
        "h": 34,
        "baseline": 21,
        "latex": "g_c\\coloneq\\rho_c h_c s_b",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_31",
      "type": "math",
      "x": 96,
      "y": 2530,
      "props": {
        "w": 180,
        "h": 34,
        "baseline": 21,
        "latex": "g_0\\coloneq g_a+g_c",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_32",
      "type": "text",
      "x": 76,
      "y": 2615,
