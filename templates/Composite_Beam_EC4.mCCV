        "html": "EC3 §§5.5, 6.2.5, 6.2.6, 6.2.8, 6.3.2.2; EC2 §§3.1.4, 6.2.4 and anchorage provisions.",
        "fontFamily": "Roboto",
        "fontSize": 13,
