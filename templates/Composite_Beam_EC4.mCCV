      "props": {
        "w": 630,
        "h": 19,
        "html": "This sheet is evaluated at one depth: the mid-span depth (h_A + h_B)/2, or the depth d_use (mm) set by the page for each critical section. The page combines the critical sections; see its check table.",
        "fontFamily": "Roboto",
        "fontSize": 13,
