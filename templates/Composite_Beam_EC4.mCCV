        "w": 245,
        "h": 154,
        "baseline": 18,
        "latex": "m_u(x)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ x\\le x_{u1}\\\\\\quad\\left\\Vert\\displaystyle 0\\,\\mathrm{m^2}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ x\\ge x_{u2}\\\\\\quad\\left\\Vert\\displaystyle l_u\\left(x-\\frac{x_{u1}+x_{u2}}{2}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\frac{\\left(x-x_{u1}\\right)^2}{2}\\right.\\end{array}",
        "displayMode": "auto",
