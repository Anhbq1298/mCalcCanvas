        "w": 630,
        "h": 21,
        "html": "D06 — Reference only: full connection, slab PNA, steel entirely in tension",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      },
      "groupId": "s_ec4_group_ro"
    },
