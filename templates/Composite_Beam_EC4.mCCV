        "h": 122,
        "baseline": 18,
        "latex": "v_u(x)\\coloneq\\begin{array}{||l}\\mathrm{if}\\ x\\le x_{u1}\\\\\\quad\\left\\Vert\\displaystyle 0\\,\\mathrm{m}\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ x\\ge x_{u2}\\\\\\quad\\left\\Vert\\displaystyle l_u\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle x-x_{u1}\\right.\\end{array}",
        "displayMode": "auto",
