        "h": 34,
        "baseline": 21,
        "latex": "g_c\\coloneq\\rho_c h_c s_b",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
