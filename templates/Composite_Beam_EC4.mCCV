      "y": 22771,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Fewer studs (larger spacing) lower η and add deflection; closer studs reduce it.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
