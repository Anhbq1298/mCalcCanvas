        "h": 83,
        "baseline": 18,
        "latex": "c_{rest}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ s_A\\le s_{max}\\land s_B\\le s_{max}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\end{array}",
        "displayMode": "auto",
