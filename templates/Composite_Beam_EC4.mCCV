      "props": {
        "w": 173,
        "h": 50,
        "baseline": 21,
        "latex": "f_1\\coloneq \\frac{18\\,\\mathrm{Hz}}{\\sqrt{\\frac{\\delta_{dyn}}{1\\,\\mathrm{mm}}}}",
