        "w": 221,
        "h": 34,
        "baseline": 21,
        "latex": "g_a\\coloneq m_a\\cdot9.81\\,\\mathrm{m/s^2}",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
