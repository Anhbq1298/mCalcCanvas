      "type": "math",
      "x": 396,
      "y": 25029,
      "props": {
        "w": 157,
        "h": 39,
        "baseline": 21,
        "latex": "n_{dyn}\\coloneq \\frac{E_a}{E_{c.dyn}}",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
