      "props": {
        "w": 521,
        "h": 113,
        "baseline": 18,
        "latex": "Q_{ac}\\coloneq\\begin{array}{||l}\\mathrm{if}\\ A_{ac}\\le A_f\\\\\\quad\\left\\Vert\\displaystyle A_{ac}\\left(h_c+\\frac{y_a}{2}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle Q_{fr}+t_w\\left(y_a-t_f-r\\right)\\left(h_c+\\frac{y_a+t_f+r}{2}\\right)\\right.\\end{array}",
        "displayMode": "auto",
        "displayUnit": "mm^3",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
