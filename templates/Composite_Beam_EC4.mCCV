      "x": 76,
      "y": 27235,
      "props": {
        "w": 630,
        "h": 24,
        "html": "References and SCI cross-check",
        "fontFamily": "Roboto",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2,
        "annex": {
