      "type": "math",
      "x": 396,
      "y": 13173,
      "props": {
        "w": 238,
        "h": 122,
        "baseline": 18,
        "latex": "n_x\\coloneq \\begin{array}{||l}\\mathrm{if}\\ x_v\\le x_M\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{floor}\\left(\\frac{x_v}{s_{sc.A}}+0.5\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\mathrm{floor}\\left(\\frac{L-x_v}{s_{sc.B}}+0.5\\right)\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": 3,
