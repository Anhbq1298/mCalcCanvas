        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_rj"
    },
    {
      "id": "s_ec4_rk",
      "type": "math",
      "x": 96,
      "y": 26517,
      "props": {
        "w": 406,
        "h": 26,
        "baseline": 18,
        "latex": "V_{2.Ed}\\coloneq \\max\\left(\\mathrm{at}\\left(V_v,0\\right),-\\mathrm{at}\\left(V_v,\\mathrm{last}\\left(V_v\\right)\\right)\\right)",
        "displayMode": "formulaResult",
