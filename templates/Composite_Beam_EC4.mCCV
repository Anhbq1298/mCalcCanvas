      "props": {
        "w": 181,
        "h": 83,
        "baseline": 18,
        "latex": "L_1\\coloneq\\begin{array}{||l}\\mathrm{if}\\ c_{prop}\\ge1\\\\\\quad\\left\\Vert\\displaystyle k_{LT}L\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle L\\right.\\end{array}",
