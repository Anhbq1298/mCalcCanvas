        }
      }
    },
    {
      "id": "s_ec4_s3",
      "type": "text",
      "x": 76,
      "y": 27265,
      "props": {
        "w": 630,
        "h": 19,
        "html": "SCI P364 (2009/10) Example 8, 533×165×75 S275, L = 12 m, C25/30 — same equations, checked:",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_s4",
      "type": "text",
      "x": 76,
      "y": 27290,
      "props": {
        "w": 630,
        "h": 19,
        "html": "  P_c,Rd 73.7 kN (6.19 governs), η_min 0.50, x_c 61.5 mm, M_pl,Rd 952.4 kNm, M_Rd 715.7 kNm (6.3).",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_s5",
      "type": "text",
      "x": 76,
      "y": 27315,
      "props": {
        "w": 630,
        "h": 19,
        "html": "  Rigid-plastic, PNA in flange: x_pl = (N_pl,a − N_c)/(2 f_y b) as here; SCI 903.9 vs 912 kNm here",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
