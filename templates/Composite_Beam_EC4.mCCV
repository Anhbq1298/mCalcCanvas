      "props": {
        "w": 611,
        "h": 121,
        "baseline": 18,
        "latex": "M_P\\coloneq \\begin{array}{||l}\\mathrm{if}\\ c_{NA}\\ge1\\\\\\quad\\left\\Vert\\displaystyle k_{G.M}g_0\\frac{a_P\\left(L-a_P\\right)}{2}+\\mathrm{map}\\left(M_s,a_P,k_{G.M},k_{Q.M}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\gamma_{G.sw}g_0\\frac{a_P\\left(L-a_P\\right)}{2}+M_{U.P}\\right.\\end{array}",
        "displayMode": "formulaResult",
