    {
      "id": "s_ec4_mg",
      "type": "text",
      "x": 76,
      "y": 19129,
      "props": {
        "w": 636,
        "h": 16,
        "html": "Symbolic. Blue: concrete depth <i>x</i><sub>c</sub>; red: steel PNA <i>y</i><sub>a</sub>, a separate axis (flange or web branch).",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#64748b",
        "align": "left"
      },
      "groupId": "s_ec4_group_hj"
    },
    {
      "id": "s_ec4_mh",
      "type": "text",
      "x": 76,
      "y": 19147,
      "props": {
        "w": 636,
        "h": 16,
        "html": "The branch and all values are calculated in section 9.2; the design <i>M</i><sub>Rd</sub> uses EC4 (6.3).",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#64748b",
        "align": "left"
      },
      "groupId": "s_ec4_group_hj"
    },
    {
