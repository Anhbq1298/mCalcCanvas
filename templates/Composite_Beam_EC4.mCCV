      "type": "text",
      "x": 76,
      "y": 18938,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Studs between support and x",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_mh"
    },
    {
      "id": "s_ec4_mi",
      "type": "math",
      "x": 396,
      "y": 18873,
      "props": {
        "w": 259,
        "h": 122,
        "baseline": 18,
        "latex": "n_x\\coloneq \\begin{array}{||l}\\mathrm{if}\\ x_v\\le x_M\\\\\\quad\\left\\Vert\\displaystyle n_{re}\\mathrm{floor}\\left(\\frac{x_v}{s_A}+0.5\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle n_{re}\\mathrm{floor}\\left(\\frac{L-x_v}{s_B}+0.5\\right)\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
      "printGroupId": "s_ec4_pg_mh"
    },
    {
      "id": "s_ec4_mj",
      "type": "text",
      "x": 76,
      "y": 19046,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Degree of connection at x",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_mj"
    },
    {
      "id": "s_ec4_mk",
      "type": "math",
      "x": 396,
      "y": 19001,
      "props": {
        "w": 171,
        "h": 103,
        "baseline": 18,
        "latex": "\\eta_x\\coloneq \\begin{array}{||l}\\mathrm{if}\\ n_x P_{Rd}\\ge N_{c.f}\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\frac{n_x P_{Rd}}{N_{c.f}}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
