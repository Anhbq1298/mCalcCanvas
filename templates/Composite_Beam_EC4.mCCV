      "type": "text",
      "x": 76,
      "y": 28341,
      "props": {
        "w": 630,
        "h": 18,
        "html": "Second moment, dynamic",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_tm"
    },
    {
