    {
      "id": "s_ec4_37",
      "type": "text",
      "x": 76,
      "y": 2465,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Self weight of the steel g_a, wet slab g_c and their sum g_0 (carried in every stage):",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_38",
      "type": "math",
      "x": 96,
      "y": 2490,
      "props": {
        "w": 229,
        "h": 34,
        "baseline": 21,
        "latex": "g_a\\coloneq m_a\\cdot9.81\\,\\mathrm{m/s^2}",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
    {
      "id": "s_ec4_39",
      "type": "math",
      "x": 436,
      "y": 2490,
      "props": {
        "w": 165,
        "h": 34,
        "baseline": 21,
        "latex": "g_c\\coloneq\\rho_c h_c s_b",
        "displayMode": "formulaResult",
        "displayUnit": "kN/m",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      }
    },
