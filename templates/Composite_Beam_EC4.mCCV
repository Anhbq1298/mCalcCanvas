      "props": {
        "w": 472,
        "h": 37,
        "baseline": 24,
        "latex": "M_P\\coloneq \\gamma_G g_0\\frac{a_P\\left(L-a_P\\right)}{2}+\\mathrm{map}\\left(M_s,a_P,\\gamma_G,\\gamma_Q\\right)",
