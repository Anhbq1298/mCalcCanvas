    {
      "id": "s_ec4_h1",
      "type": "text",
      "x": 76,
      "y": 12707,
      "props": {
        "w": 630,
        "h": 21,
        "html": "4.5 Studs and resistance along the span (§6.6.1.3)",
        "fontFamily": "Roboto",
        "fontSize": 14,
        "color": "#334155",
        "align": "left",
        "heading": 3
      }
    },
    {
      "id": "s_ec4_h2",
      "type": "text",
      "x": 76,
      "y": 12734,
      "props": {
        "w": 630,
        "h": 19,
        "html": "Shear spans run from each support to x_M; a large point load moves x_M and the stud counts.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_h3",
      "type": "text",
      "x": 76,
      "y": 12941,
      "props": {
        "w": 630,
        "h": 19,
        "html": "If the studs that fit cannot reach η_min, see chapter 6 (non-composite alternative).",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_h4",
      "type": "text",
      "x": 76,
      "y": 12978,
      "props": {
        "w": 304,
        "h": 18,
        "html": "η needed at x_M (not below η_min)",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_h4"
    },
    {
      "id": "s_ec4_h5",
      "type": "math",
      "x": 396,
      "y": 12966,
      "props": {
        "w": 302,
        "h": 43,
        "baseline": 25,
        "latex": "\\eta_{req}\\coloneq \\max\\left(\\eta_{min},\\frac{M_{2.Ed}-M_{a.Rd}}{M_{pl.Rd}-M_{a.Rd}}\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
      "printGroupId": "s_ec4_pg_h4"
    },
    {
      "id": "s_ec4_h6",
      "type": "text",
      "x": 76,
      "y": 13028,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Studs needed in each shear span",
        "fontFamily": "Roboto",
        "fontSize": 12,
        "color": "#475569",
        "align": "left"
      },
      "printGroupId": "s_ec4_pg_h6"
    },
    {
      "id": "s_ec4_h7",
      "type": "math",
      "x": 396,
      "y": 13015,
      "props": {
        "w": 197,
        "h": 43,
        "baseline": 26,
        "latex": "n_{req}\\coloneq \\mathrm{ceil}\\left(\\frac{\\eta_{req}N_{c.f}}{P_{Rd}}\\right)",
        "displayMode": "formulaResult",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
      "printGroupId": "s_ec4_pg_h6"
    },
