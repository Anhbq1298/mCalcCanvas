      "props": {
        "w": 595,
        "h": 35,
        "baseline": 22,
        "latex": "V_s(x,c_G,c_Q)\\coloneq\\mathrm{dot}\\left(c_G g_u+c_Q q_u,r_u-v_u(x)\\right)+\\mathrm{dot}\\left(c_G G_P+c_Q Q_P,\\frac{L-a_P}{L}-h_P(x)\\right)",
