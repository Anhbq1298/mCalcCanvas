        "w": 222,
        "h": 105,
        "baseline": 57,
        "latex": "\\eta_{fr}\\coloneq 1-\\frac{2A_{fr}}{A_a}",
        "displayMode": "full",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
