      "x": 396,
      "y": 18561,
      "props": {
        "w": 221,
        "h": 26,
        "baseline": 18,
        "latex": "n_{req}\\le n_h",
        "displayMode": "auto",
        "displayUnit": "",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
        "color": "#0f172a"
      },
