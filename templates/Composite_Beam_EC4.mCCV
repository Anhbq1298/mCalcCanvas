        "latex": "k_M\\coloneq\\begin{array}{||l}\\mathrm{if}\\ A_{ac}\\le0\\,\\mathrm{mm^2}\\\\\\quad\\left\\Vert\\displaystyle 0\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ A_{ac}\\le A_f\\\\\\quad\\left\\Vert\\displaystyle 1\\right.\\\\\\mathrm{else}\\ \\mathrm{if}\\ A_{ac}<A_{fr}\\\\\\quad\\left\\Vert\\displaystyle 2\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle 3\\right.\\end{array}",
