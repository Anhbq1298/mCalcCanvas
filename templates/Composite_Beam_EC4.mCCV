      "props": {
        "w": 630,
        "h": 19,
        "html": "taken as laterally stable if the slab is laterally stable. Applied when s ≤ s_max (§6.6.5.5);",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_11g",
      "type": "text",
      "x": 76,
      "y": 35265,
      "props": {
        "w": 630,
        "h": 19,
        "html": "L_LT is then the stud spacing (χ_LT = 1). Otherwise the full span is used as unrestrained.",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
    {
      "id": "s_ec4_11h",
      "type": "text",
      "x": 76,
      "y": 35335,
      "props": {
        "w": 304,
        "h": 18,
        "html": "Top flange restrained by the studs (1) or not (0)",
        "fontFamily": "Roboto",
