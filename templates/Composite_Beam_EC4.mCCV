      "y": 38299,
      "props": {
        "w": 392,
        "h": 105,
        "baseline": 18,
        "latex": "V_v\\coloneq \\begin{array}{||l}\\mathrm{if}\\ c_{NA}\\ge1\\\\\\quad\\left\\Vert\\displaystyle k_{G.V}g_0\\left(\\frac{L}{2}-x_v\\right)+\\mathrm{map}\\left(V_s,x_v,k_{G.V},k_{Q.V}\\right)\\right.\\\\\\mathrm{else}\\\\\\quad\\left\\Vert\\displaystyle \\gamma_{G.sw}g_0\\left(\\frac{L}{2}-x_v\\right)+V_{U.v}\\right.\\end{array}",
        "displayMode": "formula",
        "displayUnit": "kN",
        "precision": 3,
        "autoSize": true,
        "fontSize": 16,
