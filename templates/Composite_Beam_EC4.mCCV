      "props": {
        "w": 630,
        "h": 19,
        "html": "Strut angle chosen automatically on each surface: the largest cot θ_f in 1.0 … 2.0 (EC2 §6.2.4(4), flange in compression) with",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
