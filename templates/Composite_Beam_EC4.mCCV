    },
    {
      "id": "s_ec4_16b",
      "type": "text",
      "x": 76,
      "y": 41603,
      "props": {
        "w": 630,
        "h": 19,
        "html": "  Rigid-plastic, PNA in flange: x_pl = (N_pl,a − N_c)/(2 f_y b) as here; SCI 903.9 vs 912 kNm here",
        "fontFamily": "Roboto",
        "fontSize": 13,
        "color": "#475569",
        "align": "left"
      }
    },
