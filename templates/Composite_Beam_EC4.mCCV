    {
      "id": "s_ec4_11e",
      "type": "text",
      "x": 312,
      "y": 25321,
      "props": {
        "w": 274,
        "h": 16,
        "html": "hypothetical lower-flange PNA — rejected",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#b91c1c",
        "align": "left"
      },
      "groupId": "s_ec4_group_zm"
    },
    {
      "id": "s_ec4_11f",
      "type": "text",
      "x": 326,
      "y": 25105,
      "props": {
        "w": 340,
        "h": 16,
        "html": "Sagging, symmetric steel, no axial force, N_c ≥ 0:",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#111111",
        "align": "left"
      },
      "groupId": "s_ec4_group_zm"
    },
    {
      "id": "s_ec4_11g",
      "type": "text",
      "x": 326,
      "y": 25125,
      "props": {
        "w": 263,
        "h": 16,
        "html": "<b>A_ac = (A_a − N_c/f_yd)/2 ≤ A_a/2</b>",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#111111",
        "align": "left"
      },
      "groupId": "s_ec4_group_zm"
    },
    {
      "id": "s_ec4_11h",
      "type": "text",
      "x": 326,
      "y": 25145,
      "props": {
        "w": 301,
        "h": 16,
        "html": "so the steel PNA cannot lie below mid-depth.",
        "fontFamily": "Roboto",
        "fontSize": 11,
        "color": "#111111",
        "align": "left"
      },
      "groupId": "s_ec4_group_zm"
    },
    {
      "id": "s_ec4_11i",
      "type": "text",
      "x": 76,
      "y": 25349,
      "props": {
        "w": 630,
        "h": 24,
        "html": "References and scope of independent verification",
        "fontFamily": "Roboto",
        "fontSize": 16,
        "color": "#0f172a",
        "align": "left",
        "heading": 2,
        "annex": {
          "kind": "heading",
