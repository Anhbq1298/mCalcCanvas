      "props": {
        "w": 352,
        "h": 61,
        "baseline": 34,
        "latex": "\\mathrm{UR}_{MV.nc}\\coloneq \\max\\left(\\max\\left(\\overrightarrow{\\frac{M_v}{M_{V.nc.x}}}\\right),\\max\\left(\\overrightarrow{\\frac{M_P}{M_{V.nc.P}}}\\right)\\right)",
